{
  "schema": 1,
  "runner": "poetry",
  "source": "guide (.ai-run/guides/quality-gates.md)",
  "gates": [
    {"id": "lint", "command": "make ruff", "available": true},
    {"id": "license", "command": "make license-check", "available": true},
    {"id": "build", "command": "make build", "available": true},
    {"id": "gitleaks", "command": "make gitleaks", "available": false, "skip_reason": "Docker not required for this scoped follow-up; secret-scan skipped"},
    {"id": "affected", "command": "poetry run pytest <touched test files>", "available": true},
    {"id": "coverage", "command": "make coverage", "available": false, "skip_reason": "not requested"},
    {"id": "sonar", "command": "make sonar-local", "available": false, "skip_reason": "not requested / creds unavailable"},
    {"id": "ui", "command": "(n/a)", "available": false, "skip_reason": "no UI surface changed (Python backend only)"}
  ],
  "ui_globs": ["\\.(tsx|jsx|css|html|vue|svelte)$", "src/(ui|frontend|components)/"],
  "detected_at": "2026-07-24"
}
