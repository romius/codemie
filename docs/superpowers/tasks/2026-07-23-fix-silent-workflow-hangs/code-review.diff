+from unittest.mock import MagicMock, call, patch
+
+import pytest
+
+from codemie.core.workflow_models import WorkflowExecutionStatusEnum
+from codemie.service.workflow_execution.startup_recovery import recover_orphaned_workflow_states
+
+TERMINAL_STATUSES = [
+    WorkflowExecutionStatusEnum.FAILED,
+    WorkflowExecutionStatusEnum.SUCCEEDED,
+    WorkflowExecutionStatusEnum.ABORTED,
+    WorkflowExecutionStatusEnum.INTERRUPTED,
+]
+
+
+def _make_execution(execution_id):
+    e = MagicMock()
+    e.execution_id = execution_id
+    return e
+
+
+def _make_state(status):
+    s = MagicMock()
+    s.status = status
+    return s
+
+
+@patch("codemie.service.workflow_execution.startup_recovery.WorkflowExecutionState.get_all_by_fields")
+@patch("codemie.service.workflow_execution.startup_recovery.WorkflowExecution.get_all_by_fields")
+def test_orphaned_states_are_marked_failed(mock_exec_query, mock_state_query):
+    """IN_PROGRESS states under terminal executions must be marked FAILED at startup."""
+    exec_a = _make_execution("exec-a")
+    exec_b = _make_execution("exec-b")
+    mock_exec_query.return_value = [exec_a, exec_b]
+
+    orphan = _make_state(WorkflowExecutionStatusEnum.IN_PROGRESS)
+    done = _make_state(WorkflowExecutionStatusEnum.SUCCEEDED)
+    mock_state_query.side_effect = [
+        [orphan, done],  # exec-a
+        [],              # exec-b
+    ]
+
+    recover_orphaned_workflow_states()
+
+    assert orphan.status == WorkflowExecutionStatusEnum.FAILED
+    orphan.save.assert_called_once()
+    assert done.status == WorkflowExecutionStatusEnum.SUCCEEDED
+    done.save.assert_not_called()
+
+
+@patch("codemie.service.workflow_execution.startup_recovery.WorkflowExecutionState.get_all_by_fields")
+@patch("codemie.service.workflow_execution.startup_recovery.WorkflowExecution.get_all_by_fields")
+def test_no_orphans_produces_no_saves(mock_exec_query, mock_state_query):
+    """When no IN_PROGRESS states exist, no saves are performed."""
+    exec_a = _make_execution("exec-a")
+    mock_exec_query.return_value = [exec_a]
+    mock_state_query.return_value = [_make_state(WorkflowExecutionStatusEnum.FAILED)]
+
+    recover_orphaned_workflow_states()
+
+    for call_args in mock_state_query.return_value:
+        call_args.save.assert_not_called()
+
+
+@patch("codemie.service.workflow_execution.startup_recovery.WorkflowExecutionState.get_all_by_fields")
+@patch("codemie.service.workflow_execution.startup_recovery.WorkflowExecution.get_all_by_fields")
+def test_db_error_does_not_raise(mock_exec_query, mock_state_query):
+    """A DB failure during recovery must be swallowed — startup must not be blocked."""
+    mock_exec_query.side_effect = OSError("DB unavailable")
+
+    recover_orphaned_workflow_states()  # must not raise
