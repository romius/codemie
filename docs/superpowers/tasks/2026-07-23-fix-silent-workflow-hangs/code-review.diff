+from __future__ import annotations
+
+from datetime import datetime
+
+from codemie.configs import logger
+from codemie.core.workflow_models import WorkflowExecution, WorkflowExecutionState, WorkflowExecutionStatusEnum
+
+_TERMINAL_STATUSES = [
+    WorkflowExecutionStatusEnum.FAILED,
+    WorkflowExecutionStatusEnum.SUCCEEDED,
+    WorkflowExecutionStatusEnum.ABORTED,
+    WorkflowExecutionStatusEnum.INTERRUPTED,
+]
+
+
+def recover_orphaned_workflow_states() -> None:
+    """Mark IN_PROGRESS step states as FAILED for executions already in a terminal status.
+
+    Runs once at startup. Idempotent. Never raises — a failure is logged and startup continues.
+    """
+    try:
+        recovered = 0
+        for terminal_status in _TERMINAL_STATUSES:
+            executions = WorkflowExecution.get_all_by_fields(fields={"overall_status": terminal_status})
+            for execution in executions:
+                states = WorkflowExecutionState.get_all_by_fields(
+                    fields={"execution_id": execution.execution_id}
+                )
+                for state in states:
+                    if state.status == WorkflowExecutionStatusEnum.IN_PROGRESS:
+                        state.status = WorkflowExecutionStatusEnum.FAILED
+                        state.completed_at = datetime.now()
+                        state.save()
+                        recovered += 1
+        if recovered:
+            logger.info(f"Startup recovery: marked {recovered} orphaned IN_PROGRESS state(s) as FAILED.")
+        else:
+            logger.info("Startup recovery: no orphaned workflow states found.")
+    except Exception as exc:
+        logger.warning(f"Startup recovery scan failed: {exc}. Orphaned states will remain until the next restart.")
