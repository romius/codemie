+_GITHUB_COM_HOSTS = frozenset({"github.com", "api.github.com"})
+
+
+def _normalize_github_base_url(value: Optional[str]) -> Optional[str]:
+    """Normalize a GHE hostname or URL to the PyGithub-compatible base URL.
+
+    Returns None for missing/blank values or github.com (PyGithub's default
+    https://api.github.com already handles that). Otherwise returns
+    'https://{host}/api/v3' — no trailing slash, WITH the /api/v3 suffix that
+    GHE Server requires. A trailing slash would break every request path.
+    """
+    if value is None:
+        return None
+    trimmed = value.strip()
+    if not trimmed:
+        return None
+    parsed = urlparse(trimmed if "://" in trimmed else f"https://{trimmed}")
+    host = (parsed.hostname or "").lower()
+    if not host or host in _GITHUB_COM_HOSTS:
+        return None
+    scheme = parsed.scheme or "https"
+    return f"{scheme}://{host}/api/v3"
+
 
