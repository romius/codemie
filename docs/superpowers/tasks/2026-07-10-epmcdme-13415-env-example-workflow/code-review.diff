+from pathlib import Path
+
+import pytest
+from dotenv import dotenv_values
+
+
+REPO_ROOT = Path(__file__).parents[3]
+ENV_EXAMPLE = REPO_ROOT / ".env.example"
+
+# Fields from the committed .env that must appear in .env.example
+REQUIRED_KEYS = {
+    "AZURE_OPENAI_API_KEY",
+    "AZURE_OPENAI_URL",
+    "AZURE_SPEECH_REGION",
+    "GOOGLE_PROJECT_ID",
+    "GOOGLE_REGION",
+    "GOOGLE_VERTEXAI_REGION",
+    "GOOGLE_CLAUDE_VERTEXAI_REGION",
+    "OPENAI_API_VERSION",
+    "GITLAB_IDENTIFIERS",
+    "CODEMIE_PRECOMMIT_ENABLED",
+    "LITELLM_PREMIUM_MODELS_ALIASES",
+    "ENABLE_USER_MANAGEMENT",
+    "IDP_PROVIDER",
+    "SUPERADMIN_EMAIL",
+    "SUPERADMIN_PASSWORD",
+    "EMAIL_VERIFICATION_ENABLED",
+    "PASSWORD_MIN_LENGTH",
+    "RATE_LIMIT_LOGIN",
+    # Additional keys flagged as missing from technical-analysis
+    "GOOGLE_OAUTH_CLIENT_ID",
+    "GOOGLE_OAUTH_CLIENT_SECRET",
+    "CALLBACK_API_BASE_URL",
+    "MCP_AUTH_ENABLED",
+    "MCP_AUTH_HMAC_SECRET",
+    "ENV",
+    "MODELS_ENV",
+    "MEMORY_PROFILING_ENABLED",
+}
+
+
+def test_env_example_exists():
+    assert ENV_EXAMPLE.exists(), ".env.example must exist at the repo root"
+
+
+def test_env_example_is_parseable():
+    values = dotenv_values(ENV_EXAMPLE)
+    assert isinstance(values, dict)
+    assert len(values) > 0, ".env.example must not be empty"
+
+
+def test_env_example_contains_required_keys():
+    values = dotenv_values(ENV_EXAMPLE)
+    missing = REQUIRED_KEYS - values.keys()
+    assert not missing, f".env.example is missing required keys: {sorted(missing)}"
+
+
+def test_env_example_superadmin_password_is_not_plaintext():
+    values = dotenv_values(ENV_EXAMPLE)
+    password = values.get("SUPERADMIN_PASSWORD", "")
+    assert password != "password", (
+        "SUPERADMIN_PASSWORD in .env.example must not be 'password' — use a placeholder like 'changeme'"
+    )
