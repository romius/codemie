--- /dev/null
+++ b/src/codemie/core/a2ui/legacy_converter.py
@@ -0,0 +1,701 @@
+# Copyright 2026 EPAM Systems, Inc. ("EPAM")
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+
+"""Deterministic converter from the legacy interactive protocol to A2UI.
+
+Stored conversation history carries the fixed-schema interactive protocol
+(``interactive_request`` on the assistant message, ``interactive_response`` on
+the user message). This module maps that data onto the A2UI wire fields
+(``a2ui_envelopes`` / ``a2ui_action`` / ``a2ui_data_model``) so historical chats
+render through the same A2UI renderer as new ones.
+
+Properties relied on by the data migration:
+
+* **Additive** — the legacy fields are never removed, so a converted message is
+  readable by both protocols.
+* **Idempotent** — a message that already carries the A2UI field is returned
+  unchanged, so the migration can be re-run safely.
+* **Reversible** — :func:`reverse_message` reconstructs the legacy payload from
+  the A2UI fields (modulo the documented losses below), which is what makes the
+  conversion auditable/round-trip testable.
+
+Element mapping
+---------------
+``text`` -> ``Text``; ``column``/``row`` -> ``Column``/``Row`` (the legacy tree is
+flattened into A2UI's adjacency list under a synthesized ``root`` Column; every
+element without an id of its own gets the deterministic id
+``<parent id>-c<index>``); ``button`` -> ``Button`` plus a separate ``Text``
+component (id ``<button id>-label``) because A2UI buttons reference their label
+by id; ``multiple_choice`` -> ``ChoicePicker`` (``mutuallyExclusive`` when the cap
+is 1, otherwise ``multipleSelection``); ``dropdown`` -> ``ChoicePicker``
+(``mutuallyExclusive``, labelled); ``date_picker`` -> ``DateTimeInput``
+(``enableDate``); ``text_field`` -> ``TextField``; ``checkbox`` -> ``CheckBox``.
+``required``/``email`` validation becomes catalog ``checks``; a text field regex
+becomes ``validationRegexp``.
+
+Response mapping
+----------------
+``submit``/``action`` carry the button id as the A2UI action name (a submit with
+no button uses :data:`DEFAULT_ACTION_NAME`); ``choice``/``form`` have no button, so
+they use the default name too. Answers become the surface data model keyed by
+element id. ``text_fallback`` is plain free text and is deliberately NOT converted.
+
+Loss registry (things reverse cannot restore exactly)
+-----------------------------------------------------
+1. ``button.style``: A2UI's Basic Catalog has no destructive variant, so both
+   ``secondary`` and ``danger`` map to ``default`` and come back as ``secondary``.
+2. ``dropdown.placeholder``: no A2UI equivalent; dropped.
+3. ``multiple_choice.max_allowed_selections``: ``ChoicePicker`` has no maximum, so
+   any cap > 1 comes back as ``len(options)``.
+4. Response ``kind``: ``submit``/``choice``/``form`` all collapse into one action +
+   data model, so reverse always produces ``submit``.
+5. A button whose id literally equals :data:`DEFAULT_ACTION_NAME` is
+   indistinguishable from "submitted without a button"; reverse yields
+   ``payload.action = None``.
+6. ``date_picker`` values and bounds are padded to full ISO datetimes (A2UI's
+   ``DateTimeInput`` rejects a bare date for ``min``/``max``); reverse truncates
+   back to the date part.
+7. A ``choice`` response converted without its request in context cannot know the
+   choice element's id and falls back to :data:`FALLBACK_CHOICE_ID`
+   (:func:`convert_history` always resolves the id from the paired request).
+8. Legacy elements without an id (``text``/``column``/``row``) gain synthesized
+   ids, which reverse drops again (reverse never restores container/text ids).
+9. Ids are de-collided (see :class:`_IdAllocator`): a legacy surface that repeats
+   the same id on two elements keeps it only on the first, because A2UI rejects
+   duplicate component ids. Such a surface was already ambiguous under the legacy
+   protocol, whose answers were keyed by that same id.
+
+Output that fails :func:`codemie.core.a2ui.catalog.validate_envelopes` is never
+persisted: :func:`convert_message` raises :class:`ConversionError` and
+:func:`convert_history` leaves the message untouched.
+"""
+
+import logging
+from typing import Any, Iterable, Optional
+
+from codemie.core.a2ui import adapter, catalog
+
+logger = logging.getLogger(__name__)
+
+LEGACY_REQUEST_KEY = "interactive_request"
+LEGACY_RESPONSE_KEY = "interactive_response"
+A2UI_ENVELOPES_KEY = "a2ui_envelopes"
+A2UI_ACTION_KEY = "a2ui_action"
+A2UI_DATA_MODEL_KEY = "a2ui_data_model"
+A2UI_KEYS = (A2UI_ENVELOPES_KEY, A2UI_ACTION_KEY, A2UI_DATA_MODEL_KEY)
+
+ROOT_ID = "root"
+BUTTON_LABEL_SUFFIX = "-label"
+# Name used when the legacy response carries no button id (choice/form, or a bare submit).
+DEFAULT_ACTION_NAME = "submit"
+# Data-model key for a `choice` answer converted without its request in context.
+FALLBACK_CHOICE_ID = "choice"
+
+REQUIRED_MESSAGE = "This field is required."
+EMAIL_MESSAGE = "Enter a valid email address."
+
+_MIDNIGHT_SUFFIX = "T00:00:00"
+
+# Legacy button style -> A2UI Button variant. `danger` has no catalog equivalent.
+_STYLE_TO_VARIANT = {"primary": "primary", "secondary": "default", "danger": "default"}
+_VARIANT_TO_STYLE = {"primary": "primary", "default": "secondary", "borderless": "secondary"}
+
+
+def _text_component(component_id: str, text: Any) -> dict[str, Any]:
+    return {"id": component_id, "component": "Text", "text": "" if text is None else str(text)}
+
+
+def _check(call: str, path: str, message: str) -> dict[str, Any]:
+    return {"condition": {"call": call, "args": {"value": {"path": path}}}, "message": message}
+
+
+def _binding(component_id: str) -> dict[str, str]:
+    return {"path": f"/{component_id}"}
+
+
+def _options(element: dict) -> list[dict[str, Any]]:
+    raw = element.get("options") or []
+    return [{"label": option.get("label", ""), "value": option.get("value", "")} for option in raw]
+
+
+def _to_iso_datetime(value: Optional[str]) -> Optional[str]:
+    """Pad a bare ISO date to a full ISO datetime; A2UI rejects `YYYY-MM-DD` bounds."""
+    if not isinstance(value, str) or not value:
+        return None
+    return value if "T" in value else f"{value}{_MIDNIGHT_SUFFIX}"
+
+
+def _to_iso_date(value: Any) -> Any:
+    """Inverse of :func:`_to_iso_datetime` — keep only the date part."""
+    return value.split("T", 1)[0] if isinstance(value, str) and "T" in value else value
+
+
+def _validation(element: dict) -> dict:
+    validation = element.get("validation")
+    return validation if isinstance(validation, dict) else {}
+
+
+class _IdAllocator:
+    """Hands out unique A2UI component ids for one surface.
+
+    A2UI rejects a surface with duplicate component ids, so every id this converter
+    emits goes through here. An id the legacy surface actually uses always wins:
+    synthesized ids (``root``, ``<button>-label``, ``<parent>-c<i>``) step aside for
+    a real element that already claims the name, and a real id repeated by the legacy
+    surface is suffixed on its later occurrences. Collisions are resolved by appending
+    ``-2``, ``-3``, ... so the same surface always converts to the same ids.
+    """
+
+    def __init__(self, reserved: set[str]) -> None:
+        self._reserved = reserved
+        self._used: set[str] = set()
+
+    def claim(self, candidate: str, *, synthesized: bool) -> str:
+        # A real id only has to avoid ids already emitted; a synthesized one must also
+        # avoid the real ids still to come.
+        taken = self._used | self._reserved if synthesized else self._used
+        unique = candidate
+        suffix = 2
+        while unique in taken:
+            unique = f"{candidate}-{suffix}"
+            suffix += 1
+        self._used.add(unique)
+        return unique
+
+
+def _emit_text(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    out.append(_text_component(component_id, element.get("content", "")))
+
+
+def _emit_button(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    label_id = ids.claim(f"{component_id}{BUTTON_LABEL_SUFFIX}", synthesized=True)
+    out.append(
+        {
+            "id": component_id,
+            "component": "Button",
+            "child": label_id,
+            "variant": _STYLE_TO_VARIANT.get(element.get("style") or "primary", "default"),
+            # The event name is the button id, so the client's action envelope carries
+            # exactly what the legacy `payload.action` carried.
+            "action": {"event": {"name": component_id}},
+        }
+    )
+    out.append(_text_component(label_id, element.get("label", "")))
+
+
+def _emit_multiple_choice(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    cap = element.get("max_allowed_selections") or 1
+    out.append(
+        {
+            "id": component_id,
+            "component": "ChoicePicker",
+            # No label: a legacy multiple_choice has none, and the absent label is what
+            # distinguishes it from a dropdown on the way back.
+            "variant": "mutuallyExclusive" if cap == 1 else "multipleSelection",
+            "options": _options(element),
+            "value": _binding(component_id),
+        }
+    )
+
+
+def _emit_dropdown(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    component = {
+        "id": component_id,
+        "component": "ChoicePicker",
+        "label": element.get("label", ""),
+        "variant": "mutuallyExclusive",
+        "options": _options(element),
+        "value": _binding(component_id),
+    }
+    if element.get("required"):
+        component["checks"] = [_check("required", f"/{component_id}", REQUIRED_MESSAGE)]
+    out.append(component)
+
+
+def _emit_date_picker(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    component = {
+        "id": component_id,
+        "component": "DateTimeInput",
+        "label": element.get("label", ""),
+        "value": _binding(component_id),
+        "enableDate": True,
+    }
+    for bound in ("min", "max"):
+        value = _to_iso_datetime(element.get(bound))
+        if value is not None:
+            component[bound] = value
+    if element.get("required"):
+        component["checks"] = [_check("required", f"/{component_id}", REQUIRED_MESSAGE)]
+    out.append(component)
+
+
+def _emit_text_field(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    validation = _validation(element)
+    component = {
+        "id": component_id,
+        "component": "TextField",
+        "label": element.get("label", ""),
+        "value": _binding(component_id),
+        "variant": "shortText",
+    }
+    if validation.get("regex"):
+        component["validationRegexp"] = validation["regex"]
+    checks = []
+    if validation.get("required"):
+        checks.append(_check("required", f"/{component_id}", REQUIRED_MESSAGE))
+    if validation.get("email"):
+        checks.append(_check("email", f"/{component_id}", EMAIL_MESSAGE))
+    if checks:
+        component["checks"] = checks
+    out.append(component)
+
+
+def _emit_checkbox(element: dict, component_id: str, out: list, ids: _IdAllocator) -> None:
+    component = {
+        "id": component_id,
+        "component": "CheckBox",
+        "label": element.get("label", ""),
+        "value": _binding(component_id),
+    }
+    if _validation(element).get("required"):
+        component["checks"] = [_check("required", f"/{component_id}", REQUIRED_MESSAGE)]
+    out.append(component)
+
+
+_LEAF_EMITTERS = {
+    "text": _emit_text,
+    "button": _emit_button,
+    "multiple_choice": _emit_multiple_choice,
+    "dropdown": _emit_dropdown,
+    "date_picker": _emit_date_picker,
+    "text_field": _emit_text_field,
+    "checkbox": _emit_checkbox,
+}
+_CONTAINERS = {"column": "Column", "row": "Row"}
+
+
+def _emit_element(element: Any, fallback_id: str, out: list, ids: _IdAllocator) -> str:
+    """Append the A2UI component(s) for one legacy element; return its component id."""
+    if not isinstance(element, dict):
+        raise ValueError(f"Unsupported legacy element: {element!r}")
+    element_type = element.get("type")
+    legacy_id = element.get("id")
+    component_id = ids.claim(legacy_id, synthesized=False) if legacy_id else ids.claim(fallback_id, synthesized=True)
+    if element_type in _CONTAINERS:
+        _emit_container(element.get("children") or [], component_id, _CONTAINERS[element_type], out, ids)
+        return component_id
+    emitter = _LEAF_EMITTERS.get(element_type)
+    if emitter is None:
+        raise ValueError(f"Unsupported legacy element type: {element_type!r}")
+    emitter(element, component_id, out, ids)
+    return component_id
+
+
+def _emit_container(children: list, container_id: str, component: str, out: list, ids: _IdAllocator) -> None:
+    child_ids: list[str] = []
+    out.append({"id": container_id, "component": component, "children": child_ids})
+    for index, child in enumerate(children):
+        child_ids.append(_emit_element(child, f"{container_id}-c{index}", out, ids))
+
+
+def _legacy_ids(surface: Any) -> set[str]:
+    """Every id the legacy surface itself uses — synthesized ids must not shadow these."""
+    return {str(element["id"]) for element in _iter_legacy_elements(surface) if element.get("id")}
+
+
+def build_components(surface: list) -> list[dict[str, Any]]:
+    """Flatten a legacy surface tree into an A2UI adjacency list rooted at ``root``.
+
+    The root Column is emitted first; its id is ``root`` unless the legacy surface
+    already uses that id (see :class:`_IdAllocator`), which is why
+    :func:`reverse_request` locates the root structurally rather than by name.
+    """
+    components: list[dict[str, Any]] = []
+    ids = _IdAllocator(_legacy_ids(surface))
+    _emit_container(surface or [], ids.claim(ROOT_ID, synthesized=True), "Column", components, ids)
+    return components
+
+
+def convert_request(request: dict) -> list[dict[str, Any]]:
+    """Legacy ``interactive_request`` -> A2UI surface envelopes (``request_id`` = surfaceId)."""
+    surface_id = str(request.get("request_id") or "")
+    return adapter.build_surface_envelopes(surface_id, build_components(request.get("surface") or []))
+
+
+def _iter_legacy_elements(surface: Any) -> Iterable[dict]:
+    if not isinstance(surface, list):
+        return
+    for element in surface:
+        if not isinstance(element, dict):
+            continue
+        yield element
+        yield from _iter_legacy_elements(element.get("children"))
+
+
+def _elements_by_id(surface: Any) -> dict[str, dict]:
+    return {element["id"]: element for element in _iter_legacy_elements(surface) if element.get("id")}
+
+
+def _action_envelope(name: str, surface_id: Any) -> dict[str, Any]:
+    return {
+        "version": adapter.WIRE_VERSION,
+        "action": {"name": name, "surfaceId": str(surface_id or "")},
+    }
+
+
+def _data_model_value(element: Optional[dict], answer: Any) -> Any:
+    """One legacy answer -> its data-model value, typed by the element it answers."""
+    element_type = (element or {}).get("type")
+    if isinstance(answer, dict) and "selected" in answer:
+        return list(answer.get("selected") or [])
+    value = answer.get("value") if isinstance(answer, dict) else answer
+    if element_type == "multiple_choice":
+        return list(value or [])
+    if element_type == "dropdown":
+        # A ChoicePicker binds to a string array even when mutually exclusive.
+        return [value] if isinstance(value, str) and value else []
+    if element_type == "date_picker":
+        return _to_iso_datetime(value) if isinstance(value, str) else value
+    return value
+
+
+def _data_model_from_answers(answers: dict, elements: dict[str, dict]) -> dict[str, Any]:
+    return {
+        element_id: _data_model_value(elements.get(element_id), answer)
+        for element_id, answer in answers.items()
+        if answer is not None
+    }
+
+
+def _single_choice_id(elements: dict[str, dict]) -> Optional[str]:
+    """Id of the surface's only ``multiple_choice`` element (legacy `choice` targets it)."""
+    ids = [element_id for element_id, element in elements.items() if element.get("type") == "multiple_choice"]
+    return ids[0] if len(ids) == 1 else None
+
+
+def convert_response(
+    response: dict, surface: Optional[list] = None
+) -> tuple[Optional[dict[str, Any]], Optional[dict[str, Any]]]:
+    """Legacy ``interactive_response`` -> (action envelope, data model).
+
+    ``(None, None)`` for ``text_fallback``: free text has no A2UI representation.
+    ``surface`` is the legacy surface of the answered request; it is what lets a
+    value-typed answer be bound the way its component expects.
+    """
+    kind = response.get("kind")
+    if kind == "text_fallback":
+        return None, None
+    request_id = response.get("request_id")
+    payload = response.get("payload") or {}
+    elements = _elements_by_id(surface)
+    if kind == "action":
+        return _action_envelope(str(payload.get("action") or DEFAULT_ACTION_NAME), request_id), None
+    if kind == "submit":
+        action = _action_envelope(str(payload.get("action") or DEFAULT_ACTION_NAME), request_id)
+        return action, _data_model_from_answers(payload.get("answers") or {}, elements)
+    if kind == "form":
+        values = payload.get("values") or {}
+        data_model = {
+            element_id: _data_model_value(elements.get(element_id), {"value": value})
+            for element_id, value in values.items()
+        }
+        return _action_envelope(DEFAULT_ACTION_NAME, request_id), data_model
+    if kind == "choice":
+        choice_id = _single_choice_id(elements) or FALLBACK_CHOICE_ID
+        selected = list(payload.get("selected") or [])
+        return _action_envelope(DEFAULT_ACTION_NAME, request_id), {choice_id: selected}
+    raise ValueError(f"Unsupported legacy response kind: {kind!r}")
+
+
+class ConversionError(ValueError):
+    """A legacy message could not be converted into a usable A2UI payload."""
+
+
+def convert_message(message: dict, request: Optional[dict] = None, context: Optional[str] = None) -> dict:
+    """Add the A2UI fields derived from a message's legacy interactive fields.
+
+    Returns a new dict; the legacy fields are kept and existing A2UI fields are
+    never overwritten (idempotent). ``request`` is the legacy request answered by
+    this message, used to type the answers (see :func:`convert_response`).
+    ``context`` identifies the message in error messages (conversation id / index).
+
+    Raises :class:`ConversionError` when the produced envelopes do not validate
+    against the catalog: an unrenderable surface must never be persisted, and the
+    caller is expected to keep the original message instead.
+    """
+    if not isinstance(message, dict):
+        return message
+    converted = dict(message)
+    legacy_request = message.get(LEGACY_REQUEST_KEY)
+    if isinstance(legacy_request, dict) and not message.get(A2UI_ENVELOPES_KEY):
+        envelopes = convert_request(legacy_request)
+        errors = catalog.validate_envelopes(envelopes)
+        if errors:
+            raise ConversionError(f"invalid A2UI envelopes for {context or 'message'}: {'; '.join(errors)}")
+        converted[A2UI_ENVELOPES_KEY] = envelopes
+    legacy_response = message.get(LEGACY_RESPONSE_KEY)
+    if isinstance(legacy_response, dict) and not message.get(A2UI_ACTION_KEY):
+        action, data_model = convert_response(legacy_response, (request or {}).get("surface"))
+        if action is not None:
+            converted[A2UI_ACTION_KEY] = action
+            if data_model is not None:
+                converted[A2UI_DATA_MODEL_KEY] = data_model
+    return converted
+
+
+def _reverse_checks(component: dict) -> dict[str, bool]:
+    calls = {
+        check.get("condition", {}).get("call")
+        for check in component.get("checks") or []
+        if isinstance(check, dict) and isinstance(check.get("condition"), dict)
+    }
+    return {"required": "required" in calls, "email": "email" in calls}
+
+
+def _reverse_field_validation(component: dict) -> Optional[dict]:
+    flags = _reverse_checks(component)
+    regex = component.get("validationRegexp")
+    if not flags["required"] and not flags["email"] and not regex:
+        return None
+    return {"required": flags["required"], "regex": regex, "email": flags["email"]}
+
+
+def _reverse_choice_picker(component: dict, component_id: str) -> dict:
+    options = [
+        {"value": option.get("value", ""), "label": option.get("label", "")}
+        for option in component.get("options") or []
+    ]
+    if "label" in component:
+        # A labelled picker is a legacy dropdown; an unlabelled one a multiple_choice.
+        return {
+            "type": "dropdown",
+            "id": component_id,
+            "label": component.get("label", ""),
+            "options": options,
+            "required": _reverse_checks(component)["required"],
+        }
+    cap = 1 if component.get("variant") == "mutuallyExclusive" else len(options)
+    return {
+        "type": "multiple_choice",
+        "id": component_id,
+        "options": options,
+        "max_allowed_selections": max(cap, 1),
+    }
+
+
+def _reverse_component(component_id: str, components: dict[str, dict]) -> dict:
+    component = components.get(component_id) or {}
+    name = component.get("component")
+    if name in ("Column", "Row"):
+        return {
+            "type": "column" if name == "Column" else "row",
+            "children": [_reverse_component(child, components) for child in component.get("children") or []],
+        }
+    if name == "Text":
+        return {"type": "text", "content": component.get("text", "")}
+    if name == "Button":
+        label = components.get(component.get("child") or "", {}).get("text", "")
+        return {
+            "type": "button",
+            "id": component_id,
+            "label": label,
+            "style": _VARIANT_TO_STYLE.get(component.get("variant") or "primary", "secondary"),
+        }
+    if name == "ChoicePicker":
+        return _reverse_choice_picker(component, component_id)
+    if name == "DateTimeInput":
+        return {
+            "type": "date_picker",
+            "id": component_id,
+            "label": component.get("label", ""),
+            "min": _to_iso_date(component.get("min")),
+            "max": _to_iso_date(component.get("max")),
+            "required": _reverse_checks(component)["required"],
+        }
+    if name == "TextField":
+        return {
+            "type": "text_field",
+            "id": component_id,
+            "label": component.get("label", ""),
+            "validation": _reverse_field_validation(component),
+        }
+    if name == "CheckBox":
+        return {
+            "type": "checkbox",
+            "id": component_id,
+            "label": component.get("label", ""),
+            "validation": _reverse_field_validation(component),
+        }
+    raise ValueError(f"Unsupported A2UI component: {name!r}")
+
+
+def _root_component(order: list[str], components: dict[str, dict]) -> dict:
+    """The surface root: the first component nothing else references as a child.
+
+    Looked up structurally because the synthesized root id yields to a legacy element
+    that already uses :data:`ROOT_ID` (see :class:`_IdAllocator`).
+    """
+    referenced: set[str] = set()
+    for component in components.values():
+        referenced.update(child for child in component.get("children") or [] if isinstance(child, str))
+        child = component.get("child")
+        if isinstance(child, str):
+            referenced.add(child)
+    root_id = next((component_id for component_id in order if component_id not in referenced), ROOT_ID)
+    return components.get(root_id) or {}
+
+
+def reverse_request(envelopes: list) -> dict:
+    """A2UI surface envelopes -> legacy ``interactive_request`` (see the loss registry)."""
+    surface_id = ""
+    components: dict[str, dict] = {}
+    order: list[str] = []
+    for envelope in envelopes or []:
+        if not isinstance(envelope, dict):
+            continue
+        for payload in envelope.values():
+            if not isinstance(payload, dict):
+                continue
+            surface_id = surface_id or str(payload.get("surfaceId") or "")
+            for component in payload.get("components") or []:
+                if isinstance(component, dict) and component.get("id"):
+                    if component["id"] not in components:
+                        order.append(component["id"])
+                    components[component["id"]] = component
+    root = _root_component(order, components)
+    surface = [_reverse_component(child, components) for child in root.get("children") or []]
+    return {"request_id": surface_id, "surface": surface}
+
+
+def _reverse_answer(element: Optional[dict], value: Any) -> dict:
+    element_type = (element or {}).get("type")
+    if element_type == "multiple_choice":
+        return {"selected": list(value or [])}
+    if element_type == "dropdown":
+        return {"value": value[0] if isinstance(value, list) and value else None}
+    if element_type == "date_picker":
+        return {"value": _to_iso_date(value)}
+    if element_type is None and isinstance(value, list):
+        # Without the surface in context a list can only be read as a selection.
+        return {"selected": list(value)}
+    return {"value": value}
+
+
+def reverse_response(action: dict, data_model: Optional[dict], surface: Optional[list] = None) -> dict:
+    """A2UI action + data model -> legacy ``interactive_response`` (always ``submit``)."""
+    envelope_action = action.get("action") or {}
+    name = envelope_action.get("name")
+    elements = _elements_by_id(surface)
+    answers = {
+        element_id: _reverse_answer(elements.get(element_id), value) for element_id, value in (data_model or {}).items()
+    }
+    return {
+        "request_id": envelope_action.get("surfaceId", ""),
+        "kind": "submit",
+        "payload": {"action": None if name == DEFAULT_ACTION_NAME else name, "answers": answers},
+    }
+
+
+def reverse_message(message: dict, request: Optional[dict] = None) -> dict:
+    """Drop a message's A2UI fields, restoring the legacy fields they encode."""
+    if not isinstance(message, dict):
+        return message
+    restored = {key: value for key, value in message.items() if key not in A2UI_KEYS}
+    envelopes = message.get(A2UI_ENVELOPES_KEY)
+    if envelopes:
+        restored[LEGACY_REQUEST_KEY] = reverse_request(envelopes)
+    action = message.get(A2UI_ACTION_KEY)
+    if isinstance(action, dict) and action:
+        restored[LEGACY_RESPONSE_KEY] = reverse_response(
+            action, message.get(A2UI_DATA_MODEL_KEY), (request or {}).get("surface")
+        )
+    return restored
+
+
+def _has_legacy_interactive(message: Any) -> bool:
+    return isinstance(message, dict) and any(
+        isinstance(message.get(key), dict) for key in (LEGACY_REQUEST_KEY, LEGACY_RESPONSE_KEY)
+    )
+
+
+def _collect_requests(history: list) -> dict[str, dict]:
+    """Index the legacy requests of a history by request_id, to resolve answers against."""
+    requests: dict[str, dict] = {}
+    for message in history:
+        if not isinstance(message, dict):
+            continue
+        request = message.get(LEGACY_REQUEST_KEY)
+        if isinstance(request, dict) and request.get("request_id"):
+            requests[str(request["request_id"])] = request
+    return requests
+
+
+def _paired_request(message: dict, requests: dict[str, dict]) -> Optional[dict]:
+    response = message.get(LEGACY_RESPONSE_KEY)
+    if not isinstance(response, dict):
+        return None
+    return requests.get(str(response.get("request_id") or ""))
+
+
+def convert_history(history: list, context: Optional[str] = None) -> tuple[list, dict[str, int]]:
+    """Convert every legacy interactive message of a conversation history.
+
+    Returns the new history and ``{"converted", "skipped", "failed"}`` counts over
+    the messages that carry legacy interactive data (plain messages are passed
+    through untouched and not counted). ``skipped`` covers messages that carry
+    legacy data but yield no A2UI fields — already-converted ones and
+    ``text_fallback`` responses. A message whose conversion raises — including one
+    whose output fails catalog validation — is counted as ``failed`` and left
+    exactly as it was, so one bad row cannot fail a migration.
+
+    ``context`` (typically the conversation id) is logged together with the message
+    index, so the rows behind a ``failed`` count can actually be found afterwards.
+    """
+    requests = _collect_requests(history or [])
+    stats = {"converted": 0, "skipped": 0, "failed": 0}
+    converted_history: list = []
+    for index, message in enumerate(history or []):
+        if not _has_legacy_interactive(message):
+            converted_history.append(message)
+            continue
+        location = f"conversation {context or '<unknown>'} message {index}"
+        try:
+            converted = convert_message(message, request=_paired_request(message, requests), context=location)
+        except Exception as error:
+            logger.warning(f"A2UI history conversion failed for {location}: {error}")
+            stats["failed"] += 1
+            converted_history.append(message)
+            continue
+        stats["converted" if converted != message else "skipped"] += 1
+        converted_history.append(converted)
+    return converted_history, stats
+
+
+def strip_a2ui_fields(history: list) -> tuple[list, int]:
+    """Remove converter-produced A2UI fields from a history (migration downgrade).
+
+    Only messages that still carry the legacy fields are touched, so surfaces
+    produced natively by the A2UI runtime are left intact. Returns the new history
+    and the number of messages changed.
+    """
+    stripped_history: list = []
+    changed = 0
+    for message in history or []:
+        if not _has_legacy_interactive(message) or not any(message.get(key) for key in A2UI_KEYS):
