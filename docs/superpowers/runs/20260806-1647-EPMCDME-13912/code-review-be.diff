+def _drain(handler, generator_queue, request):
+    stream = MagicMock()
+    with patch("codemie.rest_api.handlers.assistant_handlers.run_assistant_in_thread_pool"):
+        chunks = list(
+            handler._serve_data(
+                stream,
+                generator_queue,
+                request,
+                execution_start=time(),
+            )
+        )
+    return chunks
+
