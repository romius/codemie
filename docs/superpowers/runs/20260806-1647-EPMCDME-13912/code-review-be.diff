+
+"""Legacy interactive protocol <-> A2UI history converter."""
+
+import pytest
+
+from codemie.core.a2ui import catalog, legacy_converter
+
+# Defaults of the (now removed) legacy element models, kept here so a round-trip can be
+# compared field-by-field: the converter is history-migration code and must keep working
+# against raw legacy dicts long after the legacy protocol code is gone.
+_ELEMENT_DEFAULTS: dict[str, dict] = {
+    "text": {"content": ""},
+    "column": {"children": []},
+    "row": {"children": []},
+    "button": {"id": "", "label": "", "style": "primary"},
+    "multiple_choice": {"id": "", "options": [], "max_allowed_selections": 1},
+    "dropdown": {"id": "", "label": "", "options": [], "placeholder": None, "required": False},
+    "date_picker": {"id": "", "label": "", "min": None, "max": None, "required": False},
+    "text_field": {"id": "", "label": "", "validation": None},
+    "checkbox": {"id": "", "label": "", "validation": None},
+}
+_VALIDATION_DEFAULTS = {"required": False, "regex": None, "email": False}
+
+
+def _components(envelopes: list[dict]) -> list[dict]:
+    for envelope in envelopes:
+        if "updateComponents" in envelope:
+            return envelope["updateComponents"]["components"]
+    raise AssertionError("no updateComponents envelope")
+
+
+def _by_id(envelopes: list[dict]) -> dict[str, dict]:
+    return {component["id"]: component for component in _components(envelopes)}
+
+
+def _assert_valid(envelopes: list[dict]) -> None:
+    assert catalog.validate_envelopes(envelopes) == []
+
+
+def _normalized_element(element: dict) -> dict:
+    element_type = element.get("type")
+    normalized = {"type": element_type, **_ELEMENT_DEFAULTS.get(element_type, {}), **element}
+    if "children" in normalized:
+        normalized["children"] = [_normalized_element(child) for child in normalized["children"]]
+    validation = normalized.get("validation")
+    if isinstance(validation, dict):
+        normalized["validation"] = {**_VALIDATION_DEFAULTS, **validation}
+    return normalized
+
+
+def _normalized(request: dict) -> dict:
+    """Fill the legacy element defaults, so both sides of a round-trip are comparable."""
+    return {
+        "request_id": request.get("request_id", ""),
+        "surface": [_normalized_element(element) for element in request.get("surface", [])],
+    }
+
+
+def _request(surface: list, request_id: str = "req-1") -> dict:
+    return {"request_id": request_id, "surface": surface}
+
+
+ALL_TYPES_SURFACE = [
+    {"type": "text", "content": "Pick your options"},
+    {
+        "type": "row",
+        "children": [
+            {"type": "text", "content": "nested"},
+            {"type": "button", "id": "go", "label": "Go", "style": "primary"},
+        ],
+    },
+    {
+        "type": "column",
+        "children": [
+            {
+                "type": "multiple_choice",
+                "id": "langs",
+                "options": [{"value": "py", "label": "Python"}, {"value": "ts", "label": "TypeScript"}],
+                "max_allowed_selections": 2,
+            },
+            {
+                "type": "dropdown",
+                "id": "env",
+                "label": "Environment",
+                "options": [{"value": "dev", "label": "Dev"}, {"value": "prod", "label": "Prod"}],
+                "required": True,
+            },
+        ],
+    },
+    {"type": "date_picker", "id": "due", "label": "Due date", "min": "2020-01-01", "max": "2030-12-31"},
+    {"type": "text_field", "id": "email", "label": "Email", "validation": {"required": True, "email": True}},
+    {"type": "checkbox", "id": "agree", "label": "I agree", "validation": {"required": True}},
+]
+
+
+class TestSurfaceConversion:
+    def test_every_legacy_element_type_produces_a_valid_a2ui_surface(self):
+        envelopes = legacy_converter.convert_request(_request(ALL_TYPES_SURFACE))
+        _assert_valid(envelopes)
+
+    def test_request_id_becomes_surface_id(self):
+        envelopes = legacy_converter.convert_request(_request([{"type": "text", "content": "hi"}], "req-42"))
+        assert envelopes[0]["createSurface"]["surfaceId"] == "req-42"
+        assert all(
+            payload["surfaceId"] == "req-42"
+            for envelope in envelopes
+            for payload in envelope.values()
+            if isinstance(payload, dict)
+        )
+
+    def test_tree_is_flattened_under_a_root_column(self):
+        envelopes = legacy_converter.convert_request(
+            _request([{"type": "text", "content": "a"}, {"type": "text", "content": "b"}])
+        )
+        components = _components(envelopes)
+        assert components[0] == {"id": "root", "component": "Column", "children": ["root-c0", "root-c1"]}
+        assert _by_id(envelopes)["root-c0"] == {"id": "root-c0", "component": "Text", "text": "a"}
+
+    def test_nested_containers_get_deterministic_ids(self):
+        surface = [
+            {
+                "type": "row",
+                "children": [
+                    {"type": "column", "children": [{"type": "text", "content": "deep"}]},
+                ],
+            }
+        ]
+        envelopes = legacy_converter.convert_request(_request(surface))
+        components = _by_id(envelopes)
+        assert components["root"]["children"] == ["root-c0"]
+        assert components["root-c0"]["component"] == "Row"
+        assert components["root-c0"]["children"] == ["root-c0-c0"]
+        assert components["root-c0-c0"]["component"] == "Column"
+        assert components["root-c0-c0"]["children"] == ["root-c0-c0-c0"]
+        assert components["root-c0-c0-c0"]["text"] == "deep"
+        _assert_valid(envelopes)
+
+    def test_button_label_becomes_a_separate_text_component(self):
+        envelopes = legacy_converter.convert_request(
+            _request([{"type": "button", "id": "go", "label": "Go", "style": "primary"}])
+        )
+        components = _by_id(envelopes)
+        assert components["go"]["component"] == "Button"
+        assert components["go"]["child"] == "go-label"
+        assert components["go"]["variant"] == "primary"
+        assert components["go"]["action"] == {"event": {"name": "go"}}
+        assert components["go-label"] == {"id": "go-label", "component": "Text", "text": "Go"}
+        # The label Text is referenced only by the button, never as a sibling child.
+        assert components["root"]["children"] == ["go"]
+        _assert_valid(envelopes)
+
+    @pytest.mark.parametrize(
+        "style,variant",
+        [("primary", "primary"), ("secondary", "default"), ("danger", "default")],
+    )
+    def test_button_style_maps_to_variant(self, style, variant):
+        envelopes = legacy_converter.convert_request(
+            _request([{"type": "button", "id": "b", "label": "L", "style": style}])
+        )
+        assert _by_id(envelopes)["b"]["variant"] == variant
+
+    def test_single_select_multiple_choice_becomes_mutually_exclusive_picker(self):
+        envelopes = legacy_converter.convert_request(
+            _request(
+                [
+                    {
+                        "type": "multiple_choice",
+                        "id": "one",
+                        "options": [{"value": "a", "label": "A"}],
+                        "max_allowed_selections": 1,
+                    }
+                ]
+            )
+        )
+        picker = _by_id(envelopes)["one"]
+        assert picker["component"] == "ChoicePicker"
+        assert picker["variant"] == "mutuallyExclusive"
+        assert picker["options"] == [{"label": "A", "value": "a"}]
+        assert picker["value"] == {"path": "/one"}
+        # A legacy multiple_choice carries no label; the absent label is what makes it
+        # distinguishable from a dropdown on the way back.
+        assert "label" not in picker
+        _assert_valid(envelopes)
+
+    def test_multi_select_multiple_choice_becomes_multiple_selection_picker(self):
+        envelopes = legacy_converter.convert_request(
+            _request(
+                [
+                    {
+                        "type": "multiple_choice",
+                        "id": "many",
+                        "options": [{"value": "a", "label": "A"}, {"value": "b", "label": "B"}],
+                        "max_allowed_selections": 2,
+                    }
+                ]
+            )
+        )
+        assert _by_id(envelopes)["many"]["variant"] == "multipleSelection"
+
+    def test_dropdown_becomes_labelled_picker_with_required_check(self):
+        envelopes = legacy_converter.convert_request(
+            _request(
+                [
+                    {
+                        "type": "dropdown",
+                        "id": "env",
+                        "label": "Environment",
+                        "options": [{"value": "dev", "label": "Dev"}],
+                        "placeholder": "choose...",
+                        "required": True,
+                    }
+                ]
+            )
+        )
+        picker = _by_id(envelopes)["env"]
+        assert picker["component"] == "ChoicePicker"
+        assert picker["variant"] == "mutuallyExclusive"
+        assert picker["label"] == "Environment"
+        assert picker["checks"] == [
+            {
+                "condition": {"call": "required", "args": {"value": {"path": "/env"}}},
+                "message": legacy_converter.REQUIRED_MESSAGE,
+            }
+        ]
+        _assert_valid(envelopes)
+
+    def test_date_picker_bounds_are_padded_to_full_iso_datetimes(self):
+        envelopes = legacy_converter.convert_request(
+            _request([{"type": "date_picker", "id": "due", "label": "Due", "min": "2020-01-01", "max": "2030-12-31"}])
+        )
+        picker = _by_id(envelopes)["due"]
+        assert picker["component"] == "DateTimeInput"
+        assert picker["enableDate"] is True
+        assert picker["min"] == "2020-01-01T00:00:00"
+        assert picker["max"] == "2030-12-31T00:00:00"
+        _assert_valid(envelopes)
+
+    def test_text_field_validation_maps_to_regexp_and_checks(self):
+        envelopes = legacy_converter.convert_request(
+            _request(
+                [
+                    {
+                        "type": "text_field",
+                        "id": "code",
+                        "label": "Code",
+                        "validation": {"required": True, "regex": "^[A-Z]{3}$", "email": False},
+                    }
+                ]
+            )
+        )
+        field = _by_id(envelopes)["code"]
+        assert field["component"] == "TextField"
+        assert field["variant"] == "shortText"
+        assert field["validationRegexp"] == "^[A-Z]{3}$"
+        assert [check["condition"]["call"] for check in field["checks"]] == ["required"]
+        _assert_valid(envelopes)
+
+    def test_text_field_email_validation_maps_to_an_email_check(self):
+        envelopes = legacy_converter.convert_request(
+            _request([{"type": "text_field", "id": "m", "label": "M", "validation": {"email": True}}])
+        )
+        field = _by_id(envelopes)["m"]
+        assert [check["condition"]["call"] for check in field["checks"]] == ["email"]
+        assert "validationRegexp" not in field
+        _assert_valid(envelopes)
+
+    def test_text_field_without_validation_has_no_checks(self):
+        envelopes = legacy_converter.convert_request(_request([{"type": "text_field", "id": "n", "label": "N"}]))
+        assert "checks" not in _by_id(envelopes)["n"]
+
+    def test_checkbox_maps_to_checkbox_with_required_check(self):
+        envelopes = legacy_converter.convert_request(
+            _request([{"type": "checkbox", "id": "ok", "label": "Agree", "validation": {"required": True}}])
+        )
+        box = _by_id(envelopes)["ok"]
+        assert box["component"] == "CheckBox"
+        assert box["label"] == "Agree"
+        assert box["value"] == {"path": "/ok"}
+        assert [check["condition"]["call"] for check in box["checks"]] == ["required"]
+        _assert_valid(envelopes)
+
+    def test_unknown_element_type_is_rejected(self):
+        with pytest.raises(ValueError, match="Unsupported legacy element"):
+            legacy_converter.convert_request(_request([{"type": "hologram", "id": "x"}]))
+
+
+class TestResponseConversion:
+    def test_submit_maps_action_and_answers(self):
+        action, data_model = legacy_converter.convert_response(
+            {
+                "request_id": "req-1",
+                "kind": "submit",
+                "payload": {
+                    "action": "go",
+                    "answers": {
+                        "langs": {"selected": ["py"]},
+                        "env": {"value": "dev"},
+                        "due": {"value": "2026-05-01"},
+                        "email": {"value": "a@b.co"},
+                        "agree": {"value": True},
+                    },
+                },
+            },
+            surface=ALL_TYPES_SURFACE,
+        )
+        assert action == {"version": "v0.9.1", "action": {"name": "go", "surfaceId": "req-1"}}
+        assert catalog.validate_action_envelope(action) == []
+        assert data_model == {
+            "langs": ["py"],
+            # a ChoicePicker binds to a string array even when mutually exclusive
+            "env": ["dev"],
+            "due": "2026-05-01T00:00:00",
+            "email": "a@b.co",
+            "agree": True,
+        }
+
+    def test_submit_without_a_button_uses_the_default_action_name(self):
+        action, data_model = legacy_converter.convert_response(
+            {"request_id": "r", "kind": "submit", "payload": {"action": None, "answers": {}}}
+        )
+        assert action["action"]["name"] == legacy_converter.DEFAULT_ACTION_NAME
+        assert data_model == {}
+
+    def test_action_maps_to_a_bare_action_envelope(self):
+        action, data_model = legacy_converter.convert_response(
+            {"request_id": "req-2", "kind": "action", "payload": {"action": "approve"}}
+        )
+        assert action == {"version": "v0.9.1", "action": {"name": "approve", "surfaceId": "req-2"}}
+        assert data_model is None
+
+    def test_choice_selection_lands_under_the_choice_component_id(self):
+        action, data_model = legacy_converter.convert_response(
+            {"request_id": "req-1", "kind": "choice", "payload": {"selected": ["py", "ts"]}},
+            surface=ALL_TYPES_SURFACE,
+        )
+        assert action["action"] == {"name": legacy_converter.DEFAULT_ACTION_NAME, "surfaceId": "req-1"}
+        assert data_model == {"langs": ["py", "ts"]}
+
+    def test_choice_without_surface_context_falls_back_to_a_synthetic_id(self):
+        _, data_model = legacy_converter.convert_response(
+            {"request_id": "req-1", "kind": "choice", "payload": {"selected": ["py"]}}
+        )
+        assert data_model == {legacy_converter.FALLBACK_CHOICE_ID: ["py"]}
+
+    def test_form_values_become_the_data_model(self):
+        action, data_model = legacy_converter.convert_response(
+            {"request_id": "req-1", "kind": "form", "payload": {"values": {"email": "a@b.co", "agree": True}}},
+            surface=ALL_TYPES_SURFACE,
+        )
+        assert action["action"]["name"] == legacy_converter.DEFAULT_ACTION_NAME
+        assert data_model == {"email": "a@b.co", "agree": True}
+
+    def test_text_fallback_is_skipped(self):
+        assert legacy_converter.convert_response(
+            {"request_id": "req-1", "kind": "text_fallback", "payload": {"text": "just tell me"}}
+        ) == (None, None)
+
+    def test_unknown_kind_is_rejected(self):
+        with pytest.raises(ValueError, match="Unsupported legacy response kind"):
+            legacy_converter.convert_response({"request_id": "r", "kind": "telepathy", "payload": {}})
+
+
+class TestMessageConversion:
+    def test_assistant_message_gains_envelopes_and_keeps_the_legacy_request(self):
+        message = {"role": "assistant", "interactive_request": _request(ALL_TYPES_SURFACE)}
+        converted = legacy_converter.convert_message(message)
+        assert converted["interactive_request"] == message["interactive_request"]
+        _assert_valid(converted["a2ui_envelopes"])
+
+    def test_user_message_gains_action_and_data_model(self):
+        message = {
+            "role": "user",
+            "interactive_response": {
+                "request_id": "req-1",
+                "kind": "submit",
+                "payload": {"action": "go", "answers": {"email": {"value": "a@b.co"}}},
+            },
+        }
+        converted = legacy_converter.convert_message(message, request=_request(ALL_TYPES_SURFACE))
+        assert converted["a2ui_action"]["action"]["name"] == "go"
+        assert converted["a2ui_data_model"] == {"email": "a@b.co"}
+        assert converted["interactive_response"] == message["interactive_response"]
+
