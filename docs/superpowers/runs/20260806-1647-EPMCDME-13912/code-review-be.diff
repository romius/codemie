+"""convert legacy interactive history to a2ui
+
+Adds the A2UI fields (a2ui_envelopes / a2ui_action / a2ui_data_model) to
+conversation history messages that carry the legacy interactive protocol, so old
+chats render through the A2UI renderer. The legacy fields are NOT removed: the
+conversion is additive and idempotent, and the downgrade only clears the A2UI
+fields of messages that still carry their legacy counterpart (surfaces produced
+natively by the A2UI runtime are left intact).
+
+Revision ID: f1a2b3c4d5e6
+Revises: e7f8a9b0c1d2
+Create Date: 2026-08-10 18:00:00.000000
+
+"""
+
+import json
+import logging
+from typing import Sequence, Union
+
+from alembic import op
+from sqlalchemy import text
+
+from codemie.core.a2ui.legacy_converter import convert_history, strip_a2ui_fields
+
+# revision identifiers, used by Alembic.
+revision: str = "f1a2b3c4d5e6"
+down_revision: Union[str, None] = "e7f8a9b0c1d2"
+branch_labels: Union[str, Sequence[str], None] = None
+depends_on: Union[str, Sequence[str], None] = None
+
+logger = logging.getLogger(__name__)
+
+# Histories are large JSONB documents, so they are streamed in keyset-paginated
+# batches (ORDER BY id, id > last id) instead of one full table read.
+BATCH_SIZE = 200
+
+_LEGACY_MESSAGES_PREDICATE = """
+    EXISTS (
+        SELECT 1 FROM jsonb_array_elements(history) AS message
+        WHERE jsonb_typeof(message -> 'interactive_request') = 'object'
+           OR jsonb_typeof(message -> 'interactive_response') = 'object'
+    )
+"""
+
+# Only rows converted by this migration (legacy fields still present alongside the
+# A2UI ones) are eligible for the downgrade.
+_CONVERTED_MESSAGES_PREDICATE = """
+    EXISTS (
+        SELECT 1 FROM jsonb_array_elements(history) AS message
+        WHERE (
+            jsonb_typeof(message -> 'interactive_request') = 'object'
+            OR jsonb_typeof(message -> 'interactive_response') = 'object'
+        )
+        AND (
+            jsonb_typeof(message -> 'a2ui_envelopes') = 'array'
+            OR jsonb_typeof(message -> 'a2ui_action') = 'object'
+            OR jsonb_typeof(message -> 'a2ui_data_model') = 'object'
+        )
+    )
+"""
+
+_SELECT_BATCH = """
+    SELECT id, history FROM conversations
+    WHERE jsonb_typeof(history) = 'array'
+      AND id > :last_id
+      AND {predicate}
+    ORDER BY id
+    LIMIT :limit
+"""
+
+_UPDATE_HISTORY = text("UPDATE conversations SET history = CAST(:history AS jsonb) WHERE id = :id")
+
+
+def _load_history(raw):
+    """conversations.history as a list of message dicts (the driver may hand back text)."""
+    history = json.loads(raw) if isinstance(raw, str) else raw
+    return history if isinstance(history, list) else None
+
+
+def _rewrite_histories(predicate: str, rewrite) -> dict[str, int]:
+    """Stream conversations matching `predicate` and persist each rewritten history.
+
+    `rewrite` maps ``(history, conversation_id)`` to ``(new_history, stats)``; rows
+    whose history comes back unchanged are not written. The conversation id is passed
+    down so a per-message failure can be logged against the row it came from.
+    """
+    conn = op.get_bind()
+    totals = {"conversations": 0, "updated": 0}
+    last_id = ""
+    while True:
+        rows = conn.execute(
+            text(_SELECT_BATCH.format(predicate=predicate)), {"last_id": last_id, "limit": BATCH_SIZE}
+        ).fetchall()
+        if not rows:
+            break
+        for conversation_id, raw_history in rows:
+            last_id = conversation_id
+            totals["conversations"] += 1
+            history = _load_history(raw_history)
+            if history is None:
+                continue
+            new_history, stats = rewrite(history, conversation_id)
+            for key, value in stats.items():
+                totals[key] = totals.get(key, 0) + value
+            if new_history == history:
+                continue
+            conn.execute(_UPDATE_HISTORY, {"history": json.dumps(new_history), "id": conversation_id})
+            totals["updated"] += 1
+    return totals
+
+
+def upgrade() -> None:
+    """Backfill A2UI fields into legacy interactive messages of every conversation."""
+    totals = _rewrite_histories(_LEGACY_MESSAGES_PREDICATE, convert_history)
+    logger.info(
+        "A2UI history backfill complete: "
+        f"{totals['conversations']} conversations scanned, {totals['updated']} updated, "
+        f"{totals.get('converted', 0)} messages converted, {totals.get('skipped', 0)} skipped, "
+        f"{totals.get('failed', 0)} failed"
+    )
+
+
+def _revert_history(history: list, conversation_id: str) -> tuple[list, dict[str, int]]:
+    reverted_history, reverted = strip_a2ui_fields(history)
+    return reverted_history, {"reverted": reverted}
+
+
