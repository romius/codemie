+        path = value.get("path") if isinstance(value, dict) else None
+        if not isinstance(path, str):
+            continue
+        segments = [segment for segment in path.split("/") if segment]
+        if not segments:
+            continue
+        allowed.add(segments[0])
+        if len(segments) == 1:
+            owners[segments[0]] = component
