+// limitations under the License.
+//
+
+import {
+  createComponentImplementation,
+  type ReactComponentImplementation,
+} from '@a2ui/react/v0_9'
+import React from 'react'
+
+import { A2uiMediaConsent, A2uiMediaPlaceholder } from './fallback'
+import { agentUrlHost, sanitizeAgentUrl } from './sanitizeUrl'
+
+import type { ComponentApi, ComponentContext } from '@a2ui/web_core/v0_9'
+
+/**
+ * Group factories over `createComponentImplementation` (@a2ui/react v0_9).
+ *
+ * The A2UI generic binder resolves every wire prop (data bindings, function
+ * calls, actions) before our render components see it, and injects `set<Prop>`
+ * setters plus `isValid`/`validationErrors`. These factories normalize that
+ * resolved shape into three stable in-house contracts — input, layout, media —
+ * so the registry stays declarative (roughly one row per catalog component).
+ */
+
+/** Props of a component as resolved by the A2UI generic binder. */
+export type ResolvedProps = Record<string, unknown>
+
+/** Renders a child component of the surface by id (with an optional data base path). */
+export type BuildChild = (id: string, basePath?: string) => React.ReactNode
+
+/** The render contract `createComponentImplementation` invokes wrappers with. */
+export interface A2uiRenderProps {
+  props: ResolvedProps
+  buildChild?: BuildChild
+  context?: ComponentContext
+}
+
+const NOOP_BUILD_CHILD: BuildChild = () => null
+
+/** One controlled boundary between our loosely-typed wrappers and the SDK generics. */
+function implement(api: ComponentApi, Render: React.FC<A2uiRenderProps>): ReactComponentImplementation {
+  return createComponentImplementation(
+    api,
+    Render as Parameters<typeof createComponentImplementation>[1]
+  )
+}
+
+/** Direct implementation for components that need no group normalization (Text, Icon, Divider, Button). */
+export function createBasicImplementation(
+  api: ComponentApi,
+  Render: React.FC<A2uiRenderProps>
+): ReactComponentImplementation {
+  return implement(api, Render)
+}
+
+// --------------------------------------------------------------------------
+// Inputs
+// --------------------------------------------------------------------------
+
+/** Normalized contract every input renderer receives. */
+export interface InputRenderProps<TValue> {
+  label?: string
+  value?: TValue
+  setValue: (value: TValue) => void
+  validationErrors: string[]
+  /** Remaining resolved props (variant, options, min/max, …). */
+  rest: ResolvedProps
+}
+
+const noop = () => undefined
+
+/**
+ * Wraps an input renderer so it always receives {label, value, setValue,
+ * validationErrors, rest} regardless of how the binder resolved the props.
+ * Exported separately from createInputImplementation for isolated testing.
+ */
+export function createInputRender<TValue>(
+  Render: React.FC<InputRenderProps<TValue>>
+): React.FC<A2uiRenderProps> {
+  const InputRender: React.FC<A2uiRenderProps> = ({ props }) => {
+    const { label, value, setValue, validationErrors, ...rest } = props ?? {}
+    return (
+      <Render
+        label={typeof label === 'string' ? label : undefined}
+        value={value as TValue | undefined}
+        setValue={typeof setValue === 'function' ? (setValue as (value: TValue) => void) : noop}
+        validationErrors={Array.isArray(validationErrors) ? validationErrors.map(String) : []}
+        rest={rest}
+      />
+    )
+  }
+  InputRender.displayName = `A2uiInput(${Render.displayName ?? Render.name ?? 'Anonymous'})`
+  return InputRender
+}
+
+export function createInputImplementation<TValue>(
+  api: ComponentApi,
+  Render: React.FC<InputRenderProps<TValue>>
+): ReactComponentImplementation {
+  return implement(api, createInputRender(Render))
+}
+
+// --------------------------------------------------------------------------
+// Layout
+// --------------------------------------------------------------------------
+
+/** Normalized contract every layout renderer receives. */
+export interface LayoutRenderProps {
+  props: ResolvedProps
+  buildChild: BuildChild
+  /** Pre-built nodes for the component's `children` child list (if it has one). */
+  children?: React.ReactNode
+}
+
+interface ChildEntry {
+  key: string
+  node: React.ReactNode
+}
+
+/**
+ * Maps a resolved A2UI child list (plain component ids or `{id, basePath}`
+ * template entries) to keyed render entries.
+ */
+export function mapChildRefs(childList: unknown, buildChild: BuildChild): ChildEntry[] {
+  if (!Array.isArray(childList)) return []
+  const entries: ChildEntry[] = []
+  childList.forEach((ref, index) => {
+    if (typeof ref === 'string') {
+      entries.push({ key: `${ref}-${index}`, node: buildChild(ref) })
+      return
+    }
+    if (ref && typeof ref === 'object' && typeof (ref as { id?: unknown }).id === 'string') {
+      const { id, basePath } = ref as { id: string; basePath?: string }
+      entries.push({ key: `${id}-${basePath ?? index}`, node: buildChild(id, basePath) })
+    }
+  })
+  return entries
+}
+
+/** Renders a resolved child list as a fragment sequence. Returns null for non-lists. */
+export function renderChildList(childList: unknown, buildChild: BuildChild): React.ReactNode {
+  if (!Array.isArray(childList)) return null
+  return (
+    <>
+      {mapChildRefs(childList, buildChild).map(({ key, node }) => (
+        <React.Fragment key={key}>{node}</React.Fragment>
+      ))}
+    </>
+  )
+}
+
+export function createLayoutImplementation(
+  api: ComponentApi,
+  Render: React.FC<LayoutRenderProps>
+): ReactComponentImplementation {
+  const LayoutRender: React.FC<A2uiRenderProps> = ({ props, buildChild }) => {
+    const build = buildChild ?? NOOP_BUILD_CHILD
+    const resolved = props ?? {}
+    return (
+      <Render props={resolved} buildChild={build}>
+        {renderChildList(resolved.children, build)}
+      </Render>
+    )
+  }
+  LayoutRender.displayName = `A2uiLayout(${Render.displayName ?? Render.name ?? 'Anonymous'})`
+  return implement(api, LayoutRender)
+}
+
+// --------------------------------------------------------------------------
+// Media
+// --------------------------------------------------------------------------
+
+/** Normalized contract every media renderer receives. `url` is already sanitized. */
+export interface MediaRenderProps {
+  url: string
+  /** Remaining resolved props (description, fit, variant, …). */
+  rest: ResolvedProps
+}
+
+/**
+ * Wraps a media renderer with the two centralized guards every agent-authored
+ * media URL goes through:
+ *
+ * 1. Sanitization — only absolute http(s) URLs reach the renderer; anything
+ *    else renders a safe placeholder and fires no network request.
+ * 2. Consent — even a well-formed https URL is agent-authored, i.e. attacker
+ *    controlled under prompt injection. Rendering it immediately would make the
+ *    browser fetch it with the user's IP and leak whatever the agent encoded in
+ *    the URL, with no user action at all. The element is therefore mounted only
+ *    after the user clicks, with the target host shown up front.
+ *
+ * Exported separately from createMediaImplementation for isolated testing.
+ */
+export function createMediaRender(
+  Render: React.FC<MediaRenderProps>,
+  componentLabel: string
+): React.FC<A2uiRenderProps> {
+  const MediaRender: React.FC<A2uiRenderProps> = ({ props }) => {
+    const [revealed, setRevealed] = React.useState(false)
+    const { url, ...rest } = props ?? {}
+    const safeUrl = sanitizeAgentUrl(url)
+    if (!safeUrl) return <A2uiMediaPlaceholder label={componentLabel} />
+    if (!revealed) {
+      return (
+        <A2uiMediaConsent
+          label={componentLabel}
+          host={agentUrlHost(safeUrl)}
+          onReveal={() => setRevealed(true)}
+        />
+      )
+    }
+    return <Render url={safeUrl} rest={rest} />
+  }
+  MediaRender.displayName = `A2uiMedia(${componentLabel})`
+  return MediaRender
+}
+
+export function createMediaImplementation(
+  api: ComponentApi,
+  Render: React.FC<MediaRenderProps>
+): ReactComponentImplementation {
+  return implement(api, createMediaRender(Render, api.name))
+}
