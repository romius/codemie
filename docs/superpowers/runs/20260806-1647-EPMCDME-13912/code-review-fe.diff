+  star: StarOutlineIcon,
+  starHalf: StarOutlineIcon,
+  starOff: StarOutlineIcon,
+  stop: StopIcon,
+  upload: ExportIcon,
+  visibility: EyeIcon,
+  visibilityOff: EyeOffIcon,
+  warning: AlertIcon,
+}
+
+/**
+ * Rendered for icon names with no design-system counterpart, and for the
+ * catalog's custom `{svgPath}` form (agent-authored path data is never injected
+ * into the DOM). A real glyph, never an empty box.
+ */
+const DEFAULT_ICON = QuestionIcon
+
+export const IconRenderer: React.FC<A2uiRenderProps> = ({ props }) => {
+  const name = typeof props.name === 'string' ? props.name : ''
+  const IconSvg = ICON_COMPONENTS[name] ?? DEFAULT_ICON
+  return (
+    <IconSvg
+      role="img"
+      aria-label={name || 'icon'}
+      className="w-4 h-4 shrink-0 text-text-primary"
+    />
+  )
+}
+
+export const VideoRenderer: React.FC<MediaRenderProps> = ({ url }) => (
+  // eslint-disable-next-line jsx-a11y/media-has-caption -- agent-authored media has no caption track
+  <video
+    controls
+    src={url}
+    preload="none"
+    {...MEDIA_PRIVACY_PROPS}
+    className="max-w-full rounded-lg"
+  />
+)
+
+export const AudioPlayerRenderer: React.FC<MediaRenderProps> = ({ url, rest }) => (
+  <div className="flex flex-col gap-1 w-full">
+    {typeof rest.description === 'string' && rest.description && (
+      <span className="text-xs text-text-tertiary">{rest.description}</span>
+    )}
+    {/* eslint-disable-next-line jsx-a11y/media-has-caption -- agent-authored media has no caption track */}
+    <audio controls src={url} preload="none" {...MEDIA_PRIVACY_PROPS} className="w-full" />
+  </div>
+)
+
+// --------------------------------------------------------------------------
+// Layout: Row / Column / List / Card / Tabs / Modal / Divider
+// --------------------------------------------------------------------------
+
+const JUSTIFY_STYLES: Record<string, string> = {
+  start: 'justify-start',
+  center: 'justify-center',
+  end: 'justify-end',
+  spaceBetween: 'justify-between',
+  spaceAround: 'justify-around',
+  spaceEvenly: 'justify-evenly',
+  stretch: 'justify-stretch',
+}
+
+const ALIGN_STYLES: Record<string, string> = {
+  start: 'items-start',
+  center: 'items-center',
+  end: 'items-end',
+  stretch: 'items-stretch',
+}
+
+const flexClasses = (props: Record<string, unknown>, directionClass: string) =>
+  cn(
+    'flex gap-2 min-w-0',
+    directionClass,
+    JUSTIFY_STYLES[String(props.justify ?? 'start')] ?? JUSTIFY_STYLES.start,
+    ALIGN_STYLES[String(props.align ?? 'stretch')] ?? ALIGN_STYLES.stretch
+  )
+
+export const RowRenderer: React.FC<LayoutRenderProps> = ({ props, children }) => (
+  <div className={flexClasses(props, 'flex-row flex-wrap')}>{children}</div>
+)
+
+export const ColumnRenderer: React.FC<LayoutRenderProps> = ({ props, children }) => (
+  <div className={flexClasses(props, 'flex-col')}>{children}</div>
+)
+
+export const ListRenderer: React.FC<LayoutRenderProps> = ({ props, buildChild }) => {
+  const entries = mapChildRefs(props.children, buildChild)
+  const directionClass = props.direction === 'horizontal' ? 'flex-row flex-wrap' : 'flex-col'
+  const listStyle = String(props.listStyle ?? 'none')
+  if (listStyle === 'ordered' || listStyle === 'unordered') {
+    const Tag = listStyle === 'ordered' ? 'ol' : 'ul'
+    return (
+      <Tag
+        className={cn(
+          'flex gap-1 pl-5 text-sm text-text-primary',
+          directionClass,
+          listStyle === 'ordered' ? 'list-decimal' : 'list-disc'
+        )}
+      >
+        {entries.map(({ key, node }) => (
+          <li key={key}>{node}</li>
+        ))}
+      </Tag>
+    )
+  }
+  return (
+    <div className={cn('flex gap-2', directionClass)}>
+      {entries.map(({ key, node }) => (
+        <React.Fragment key={key}>{node}</React.Fragment>
+      ))}
+    </div>
+  )
+}
+
+export const CardRenderer: React.FC<LayoutRenderProps> = ({ props, buildChild }) => (
+  <div className="rounded-xl border border-border-primary bg-surface-base-secondary p-4">
+    {typeof props.child === 'string' ? buildChild(props.child) : null}
+  </div>
+)
+
+interface TabEntry {
+  title?: unknown
+  child?: unknown
+}
+
+export const TabsRenderer: React.FC<LayoutRenderProps> = ({ props, buildChild }) => {
+  const tabs: TabEntry[] = Array.isArray(props.tabs)
+    ? (props.tabs.filter((tab) => tab && typeof tab === 'object') as TabEntry[])
+    : []
+  const [activeIndex, setActiveIndex] = useState(0)
+  const active = tabs[activeIndex] ?? tabs[0]
+  return (
+    <div className="flex flex-col">
+      <div className="flex gap-1 border-b border-border-primary" role="tablist">
+        {tabs.map((tab, index) => (
+          <button
+            // Tab order is positional in the protocol; index is the stable key.
+            // eslint-disable-next-line react/no-array-index-key
+            key={index}
+            type="button"
+            role="tab"
+            aria-selected={index === activeIndex}
+            onClick={() => setActiveIndex(index)}
+            className={cn(
+              'px-3 py-1.5 text-sm transition border-b-2 -mb-px',
+              index === activeIndex
+                ? 'border-border-accent text-text-primary font-medium'
+                : 'border-transparent text-text-tertiary hover:text-text-primary'
+            )}
+          >
+            {tab.title == null ? `Tab ${index + 1}` : String(tab.title)}
+          </button>
+        ))}
+      </div>
+      <div className="pt-3">
+        {typeof active?.child === 'string' ? buildChild(active.child) : null}
+      </div>
+    </div>
+  )
+}
+
+export const ModalRenderer: React.FC<LayoutRenderProps> = ({ props, buildChild }) => {
+  const [open, setOpen] = useState(false)
+  const trigger = typeof props.trigger === 'string' ? props.trigger : null
+  const content = typeof props.content === 'string' ? props.content : null
+  return (
+    <>
+      {trigger && (
+        <div className="inline-flex cursor-pointer" onClick={() => setOpen(true)}>
+          {buildChild(trigger)}
+        </div>
+      )}
+      {open && (
+        <div
+          className="fixed inset-0 z-50 flex items-center justify-center bg-black/50"
+          role="dialog"
+          aria-modal="true"
+        >
+          <div className="relative bg-surface-base-primary rounded-xl border border-border-primary shadow-lg p-4 m-4 w-full max-w-lg max-h-[80vh] overflow-auto">
+            <button
+              type="button"
+              aria-label="Close"
+              onClick={() => setOpen(false)}
+              className="absolute top-2 right-2 text-text-tertiary hover:text-text-primary transition"
+            >
+              <CrossIcon className="w-4 h-4" />
+            </button>
+            {content ? buildChild(content) : null}
+          </div>
+        </div>
+      )}
+    </>
+  )
+}
+
+export const DividerRenderer: React.FC<A2uiRenderProps> = ({ props }) =>
+  props.axis === 'vertical' ? (
+    <div className="w-px self-stretch bg-border-primary mx-2" role="separator" />
+  ) : (
+    <hr className="w-full border-border-primary my-2" />
+  )
+
+// --------------------------------------------------------------------------
+// Button
+// --------------------------------------------------------------------------
+
+const BUTTON_TYPE_BY_VARIANT: Record<string, ButtonType> = {
+  default: ButtonType.BASE,
+  primary: ButtonType.PRIMARY,
+  borderless: ButtonType.TERTIARY,
+}
+
+export const ButtonRenderer: React.FC<A2uiRenderProps> = ({ props, buildChild, context }) => {
+  const action = typeof props.action === 'function' ? (props.action as () => void) : undefined
+  const submittedAction = useA2uiSubmittedAction()
+  const componentId = context?.componentModel?.id
+  const isSubmittedAction = Boolean(
+    submittedAction?.componentId && submittedAction.componentId === componentId
+  )
+  return (
+    <DsButton
+      type={BUTTON_TYPE_BY_VARIANT[String(props.variant ?? 'default')] ?? ButtonType.BASE}
+      disabled={props.isValid === false}
+      onClick={action}
+      {...(isSubmittedAction ? { 'data-testid': `a2ui-selected-${submittedAction!.name}` } : {})}
+    >
+      {typeof props.child === 'string' && buildChild ? buildChild(props.child) : null}
+    </DsButton>
+  )
+}
+
+// --------------------------------------------------------------------------
+// Inputs: TextField / CheckBox / ChoicePicker / Slider / DateTimeInput
+// --------------------------------------------------------------------------
+
+const TEXT_FIELD_INPUT_TYPES: Record<string, string> = {
+  shortText: 'text',
+  longText: 'text',
+  number: 'number',
+  obscured: 'password',
+}
+
+/**
+ * Parses what a number input reports into the value written to the data model.
+ *
+ * Browsers surface an unparsable numeric buffer (`1e`, `--`) as an empty string,
+ * which is indistinguishable from a cleared field: both mean "no number yet", so
+ * both write `undefined` and let the component's own `required` check speak.
+ */
+export function parseNumberFieldValue(raw: string): number | undefined {
+  const parsed = raw.trim() === '' ? NaN : Number(raw)
+  return Number.isFinite(parsed) ? parsed : undefined
+}
+
+export const TextFieldRenderer: React.FC<InputRenderProps<string | number | undefined>> = ({
+  label,
+  value,
+  setValue,
+  validationErrors,
+  rest,
+}) => {
+  const variant = typeof rest.variant === 'string' ? rest.variant : 'shortText'
+  const error = validationErrors[0]
+  const text = value == null ? '' : String(value)
+  if (variant === 'longText') {
+    return (
+      <Textarea
+        label={label}
+        value={text}
+        error={error}
+        onChange={(e) => setValue(e.target.value)}
+      />
+    )
+  }
+  if (variant === 'number') {
+    // A number field must bind a number, not its text rendering: the agent gets
+    // 3, not "3", and never a half-typed string.
+    return (
+      <Input
+        label={label}
+        type="number"
+        value={text}
+        error={error}
+        onChange={(e) => setValue(parseNumberFieldValue(e.target.value))}
+      />
+    )
+  }
+  return (
+    <Input
+      label={label}
+      type={TEXT_FIELD_INPUT_TYPES[variant] ?? 'text'}
+      value={text}
+      error={error}
+      onChange={(e) => setValue(e.target.value)}
+    />
+  )
+}
+
+export const CheckBoxRenderer: React.FC<InputRenderProps<boolean>> = ({
+  label,
+  value,
+  setValue,
+  validationErrors,
+}) => (
+  <Checkbox
+    label={label}
+    checked={Boolean(value)}
+    error={validationErrors[0]}
+    onChange={(checked) => setValue(checked)}
+  />
+)
+
+interface ChoiceOption {
+  label: string
+  value: string
+}
+
+/**
+ * Turns the agent's option list into options that can carry an identity.
+ *
+ * `value` is what the picker submits and what identifies a selection, so an
+ * option without a usable one cannot participate: coercing it to `''` would give
+ * several options the same identity, check them all at once and submit `['']`.
+ * Such options — and duplicates of an already-seen value — are dropped; the
+ * label falls back to the value so an option is never blank.
+ */
+export function normalizeChoiceOptions(raw: unknown): ChoiceOption[] {
+  if (!Array.isArray(raw)) return []
+  const seen = new Set<string>()
+  const options: ChoiceOption[] = []
+  for (const entry of raw) {
+    if (!entry || typeof entry !== 'object') continue
+    const { label, value } = entry as { label?: unknown; value?: unknown }
+    if (typeof value !== 'string' && typeof value !== 'number') continue
+    const normalizedValue = String(value).trim()
+    if (!normalizedValue || seen.has(normalizedValue)) continue
+    seen.add(normalizedValue)
+    const normalizedLabel = label == null ? '' : String(label)
+    options.push({ label: normalizedLabel || normalizedValue, value: normalizedValue })
+  }
+  return options
+}
+
+export const ChoicePickerRenderer: React.FC<InputRenderProps<string[]>> = ({
+  label,
+  value,
+  setValue,
+  validationErrors,
+  rest,
+}) => {
+  const groupId = useId()
+  const options = normalizeChoiceOptions(rest.options)
+  const optionValues = new Set(options.map((option) => option.value))
+  const rawValues = Array.isArray(value) ? value.map(String) : []
+  // Only selections that still match a rendered option count, and each at most once.
+  const values = [...new Set(rawValues.filter((current) => optionValues.has(current)))]
+  // The catalog defaults `variant` to mutuallyExclusive, so anything but an
+  // explicit multipleSelection is a single-choice picker with a cap of one.
+  const isMultiple = rest.variant === 'multipleSelection'
+  const selected = isMultiple ? undefined : values[0]
+  const error = validationErrors[0]
+
+  // Every option lost its identity (or there were none): degrade to text rather
+  // than render a control that cannot submit anything meaningful.
+  if (options.length === 0) return <A2uiFallback componentType="ChoicePicker" />
+
+  let content: React.ReactNode
+  if (isMultiple) {
+    content = (
+      <div className="flex flex-col gap-2">
+        {options.map((option) => (
+          <Checkbox
+            key={option.value}
+            label={option.label}
+            checked={values.includes(option.value)}
+            onChange={(checked) =>
+              setValue(
+                checked
+                  ? [...values, option.value]
+                  : values.filter((current) => current !== option.value)
+              )
+            }
+          />
+        ))}
+      </div>
+    )
+  } else if (rest.filterable) {
+    content = (
+      <Select
+        value={selected ?? null}
+        options={options}
+        filter
+        showClear
+        onChangeValue={(next) => setValue(next == null ? [] : [String(next)])}
+      />
+    )
+  } else {
+    content = (
+      <div className="flex flex-col gap-2">
+        {options.map((option, index) => (
+          <RadioButton
+            key={option.value}
+            inputId={`${groupId}-${index}`}
+            name={groupId}
+            label={option.label}
+            checked={selected === option.value}
+            onChange={() => setValue([option.value])}
+          />
+        ))}
+      </div>
+    )
+  }
+
+  return (
+    <div className="flex flex-col gap-2">
+      {label && <div className="text-xs text-text-quaternary">{label}</div>}
+      {content}
+      {error && <div className="text-sm text-failed-secondary">{error}</div>}
+    </div>
+  )
+}
+
+export const SliderRenderer: React.FC<InputRenderProps<number>> = ({
+  label,
+  value,
+  setValue,
+  validationErrors,
+  rest,
+}) => {
+  const sliderId = useId()
+  const min = typeof rest.min === 'number' ? rest.min : 0
+  const max = typeof rest.max === 'number' ? rest.max : 100
+  const hasValue = typeof value === 'number'
+  const current = hasValue ? value : min
+  const error = validationErrors[0]
+  // A slider always shows a position, so the data model must always hold it:
+  // otherwise the user sees `min`, never touches the control, and the agent
+  // receives nothing back for a field that looked answered.
+  useEffect(() => {
+    if (!hasValue) setValue(current)
+  }, [hasValue, current, setValue])
+  return (
+    <div className="flex flex-col gap-1">
+      <div className="flex items-center justify-between gap-2">
+        {label && (
+          <label htmlFor={sliderId} className="text-xs text-text-quaternary">
+            {label}
+          </label>
+        )}
+        <span className="text-xs text-text-tertiary">{current}</span>
+      </div>
+      <input
+        id={sliderId}
+        type="range"
+        min={min}
+        max={max}
+        value={current}
+        onChange={(e) => setValue(Number(e.target.value))}
+        className="w-full h-1.5 cursor-pointer rounded-full accent-border-accent"
+      />
+      {error && <div className="text-sm text-failed-secondary">{error}</div>}
+    </div>
+  )
+}
+
+const padTwo = (part: number) => String(part).padStart(2, '0')
+
+/** Formats a picked date into the protocol's local date/time string shape. */
+export function formatDateTimeValue(date: Date, enableTime: boolean): string {
+  const datePart = `${date.getFullYear()}-${padTwo(date.getMonth() + 1)}-${padTwo(date.getDate())}`
+  if (!enableTime) return datePart
+  return `${datePart}T${padTwo(date.getHours())}:${padTwo(date.getMinutes())}`
+}
+
+const extractTimePart = (raw: string): string => {
+  const source = raw.includes('T') ? raw.split('T')[1] ?? '' : raw
+  return source.substring(0, 5)
+}
+
+export const DateTimeInputRenderer: React.FC<InputRenderProps<string>> = ({
+  label,
+  value,
+  setValue,
+  validationErrors,
+  rest,
+}) => {
+  const enableTime = Boolean(rest.enableTime)
+  // Both flags default to false in the schema, so an agent that sets neither is
+  // still emitting a valid component. Rendering nothing would leave an invisible
+  // field that can block submission through its own checks; a date picker is the
+  // safe reading of "date/time input" and matches the catalog's own naming.
+  const enableDate = Boolean(rest.enableDate) || !enableTime
+  const error = validationErrors[0]
+  const text = typeof value === 'string' ? value : ''
+
+  if (!enableDate) {
+    // Time-only field: the DS DatePicker is date-based, use a native time input.
+    return (
+      <div className="flex flex-col gap-2">
+        {label && <div className="text-xs text-text-quaternary">{label}</div>}
+        <input
+          type="time"
+          value={extractTimePart(text)}
+          onChange={(e) => setValue(e.target.value)}
+          min={typeof rest.min === 'string' ? extractTimePart(rest.min) : undefined}
+          max={typeof rest.max === 'string' ? extractTimePart(rest.max) : undefined}
+          className="h-8 w-full px-2 text-sm text-text-primary bg-surface-base-content border border-border-primary rounded-lg transition hover:border-border-secondary focus:outline-none"
+        />
+        {error && <div className="text-sm text-failed-secondary">{error}</div>}
+      </div>
+    )
+  }
+
+  return (
+    <DatePicker
+      label={label}
+      value={text || null}
+      error={error}
+      showTime={enableTime}
+      minDate={typeof rest.min === 'string' ? rest.min : undefined}
+      maxDate={typeof rest.max === 'string' ? rest.max : undefined}
+      onChange={(iso) => setValue(iso ? formatDateTimeValue(new Date(iso), enableTime) : '')}
+    />
+  )
+}
+
+// --------------------------------------------------------------------------
+// Registry
+// --------------------------------------------------------------------------
+
+/** All 18 Basic Catalog components, one declarative row each. */
+export const A2UI_COMPONENTS: Record<string, ReactComponentImplementation> = {
+  Text: createBasicImplementation(TextApi, TextRenderer),
+  Image: createMediaImplementation(ImageApi, ImageRenderer),
+  Icon: createBasicImplementation(IconApi, IconRenderer),
+  Video: createMediaImplementation(VideoApi, VideoRenderer),
+  AudioPlayer: createMediaImplementation(AudioPlayerApi, AudioPlayerRenderer),
+  Row: createLayoutImplementation(RowApi, RowRenderer),
+  Column: createLayoutImplementation(ColumnApi, ColumnRenderer),
+  List: createLayoutImplementation(ListApi, ListRenderer),
+  Card: createLayoutImplementation(CardApi, CardRenderer),
+  Tabs: createLayoutImplementation(TabsApi, TabsRenderer),
+  Modal: createLayoutImplementation(ModalApi, ModalRenderer),
+  Divider: createBasicImplementation(DividerApi, DividerRenderer),
+  Button: createBasicImplementation(ButtonApi, ButtonRenderer),
+  TextField: createInputImplementation(TextFieldApi, TextFieldRenderer),
+  CheckBox: createInputImplementation(CheckBoxApi, CheckBoxRenderer),
+  ChoicePicker: createInputImplementation(ChoicePickerApi, ChoicePickerRenderer),
+  Slider: createInputImplementation(SliderApi, SliderRenderer),
+  DateTimeInput: createInputImplementation(DateTimeInputApi, DateTimeInputRenderer),
+}
+
+/**
+ * Component names supported by this renderer. Declared in the dependency-free
+ * `./components` module (the manifest generator reads it without a DOM) and
+ * asserted against `Object.keys(A2UI_COMPONENTS)` by the registry test.
+ */
+export { SUPPORTED_COMPONENTS } from './components'
+
+/** Builds the runtime Catalog for the MessageProcessor (components + checks functions). */
+export function createA2uiCatalog(): Catalog<ReactComponentImplementation> {
+  return new Catalog(CATALOG_ID, Object.values(A2UI_COMPONENTS), BASIC_FUNCTIONS)
+}
