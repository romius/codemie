+import { describe, expect, it, vi } from 'vitest'
+
+import {
+  CheckBoxRenderer,
+  ChoicePickerRenderer,
+  DateTimeInputRenderer,
+  SliderRenderer,
+  TextFieldRenderer,
+} from '@/a2ui/registry'
+
+// The renderers receive the normalized input contract produced by
+// createInputRender: {label, value, setValue, validationErrors, rest}.
+
+const base = { validationErrors: [] as string[], rest: {} as Record<string, unknown> }
+
+describe('TextFieldRenderer', () => {
+  it('renders the label and current value', () => {
+    render(
+      <TextFieldRenderer {...base} label="Full name" value="Ada" setValue={() => undefined} />
+    )
+    expect(screen.getByText('Full name')).toBeInTheDocument()
+    expect(screen.getByRole('textbox')).toHaveValue('Ada')
+  })
+
+  it('propagates typed input through setValue', async () => {
+    const setValue = vi.fn()
+    render(<TextFieldRenderer {...base} label="Name" value="" setValue={setValue} />)
+    await userEvent.type(screen.getByRole('textbox'), 'A')
+    expect(setValue).toHaveBeenCalledWith('A')
+  })
+
+  it('renders a textarea for the longText variant', () => {
+    render(
+      <TextFieldRenderer
+        {...base}
+        rest={{ variant: 'longText' }}
+        label="Bio"
+        value=""
+        setValue={() => undefined}
+      />
+    )
+    expect(screen.getByRole('textbox').tagName).toBe('TEXTAREA')
+  })
+
+  it('shows the first validation error', () => {
+    render(
+      <TextFieldRenderer
+        {...base}
+        validationErrors={['Required field', 'Too short']}
+        label="Name"
+        value=""
+        setValue={() => undefined}
+      />
+    )
+    expect(screen.getByText('Required field')).toBeInTheDocument()
+  })
+
+  describe('number variant', () => {
+    it('writes a number (not a string) into the data model', () => {
+      const setValue = vi.fn()
+      render(
+        <TextFieldRenderer
+          {...base}
+          rest={{ variant: 'number' }}
+          label="Age"
+          value=""
+          setValue={setValue}
+        />
+      )
+      fireEvent.change(screen.getByRole('spinbutton'), { target: { value: '42' } })
+      expect(setValue).toHaveBeenCalledWith(42)
+    })
+
+    it('writes undefined for a cleared or partially typed number', () => {
+      const setValue = vi.fn()
+      render(
+        <TextFieldRenderer
+          {...base}
+          rest={{ variant: 'number' }}
+          label="Age"
+          value={7}
+          setValue={setValue}
+        />
+      )
+      // A browser reports an unparsable numeric buffer (e.g. "1e") as an empty value.
+      fireEvent.change(screen.getByRole('spinbutton'), { target: { value: '' } })
+      expect(setValue).toHaveBeenCalledWith(undefined)
+    })
+
+    it('displays a numeric bound value', () => {
+      render(
+        <TextFieldRenderer
+          {...base}
+          rest={{ variant: 'number' }}
+          label="Age"
+          value={7}
+          setValue={() => undefined}
+        />
+      )
+      expect(screen.getByRole('spinbutton')).toHaveValue(7)
+    })
+  })
+})
+
+describe('CheckBoxRenderer', () => {
+  it('renders the label and reflects the bound value', () => {
+    render(<CheckBoxRenderer {...base} label="I agree" value={true} setValue={() => undefined} />)
+    expect(screen.getByText('I agree')).toBeInTheDocument()
+    expect(screen.getByRole('checkbox')).toBeChecked()
+  })
+
+  it('toggling calls setValue with the inverted value', async () => {
+    const setValue = vi.fn()
+    render(<CheckBoxRenderer {...base} label="I agree" value={false} setValue={setValue} />)
+    await userEvent.click(screen.getByRole('checkbox'))
+    expect(setValue).toHaveBeenCalledWith(true)
+  })
+})
+
+describe('ChoicePickerRenderer', () => {
+  const options = [
+    { label: 'Red', value: 'red' },
+    { label: 'Blue', value: 'blue' },
+  ]
+
+  it('renders a radio group for the mutuallyExclusive variant and selects a single value', async () => {
+    const setValue = vi.fn()
+    render(
+      <ChoicePickerRenderer
+        {...base}
+        rest={{ variant: 'mutuallyExclusive', options }}
+        label="Color"
+        value={[]}
+        setValue={setValue}
+      />
+    )
+    expect(screen.getByText('Color')).toBeInTheDocument()
+    const radios = screen.getAllByRole('radio')
+    expect(radios).toHaveLength(2)
+    await userEvent.click(radios[1])
+    expect(setValue).toHaveBeenCalledWith(['blue'])
+  })
+
+  it('renders a checkbox group for multipleSelection and toggles values into the array', async () => {
+    const setValue = vi.fn()
+    render(
+      <ChoicePickerRenderer
+        {...base}
+        rest={{ variant: 'multipleSelection', options }}
+        label="Colors"
+        value={['red']}
+        setValue={setValue}
+      />
+    )
+    const checkboxes = screen.getAllByRole('checkbox')
+    expect(checkboxes).toHaveLength(2)
+    await userEvent.click(checkboxes[1])
+    expect(setValue).toHaveBeenCalledWith(['red', 'blue'])
+  })
+
+  it('unselecting a checked option removes it from the value array', async () => {
+    const setValue = vi.fn()
+    render(
+      <ChoicePickerRenderer
+        {...base}
+        rest={{ variant: 'multipleSelection', options }}
+        value={['red', 'blue']}
+        setValue={setValue}
+      />
+    )
+    await userEvent.click(screen.getAllByRole('checkbox')[0])
+    expect(setValue).toHaveBeenCalledWith(['blue'])
+  })
+
+  describe('malformed agent options', () => {
+    it('drops options without a usable value instead of collapsing them onto ""', () => {
+      render(
+        <ChoicePickerRenderer
+          {...base}
+          rest={{
+            variant: 'multipleSelection',
+            options: [{ label: 'A' }, { label: 'B', value: '  ' }, { label: 'C', value: 'c' }],
+          }}
+          value={['']}
+          setValue={() => undefined}
+        />
+      )
+      const checkboxes = screen.getAllByRole('checkbox')
+      expect(checkboxes).toHaveLength(1)
+      expect(checkboxes[0]).not.toBeChecked()
+    })
+
+    it('de-duplicates options that share the same value', () => {
+      render(
+        <ChoicePickerRenderer
+          {...base}
+          rest={{
+            variant: 'multipleSelection',
+            options: [
+              { label: 'First', value: 'x' },
+              { label: 'Second', value: 'x' },
+            ],
+          }}
+          value={[]}
+          setValue={() => undefined}
+        />
+      )
+      expect(screen.getAllByRole('checkbox')).toHaveLength(1)
+      expect(screen.getByText('First')).toBeInTheDocument()
+    })
+
+    it('never emits the same value twice when toggling', async () => {
+      const setValue = vi.fn()
+      render(
+        <ChoicePickerRenderer
+          {...base}
+          rest={{ variant: 'multipleSelection', options }}
+          value={['blue', 'blue']}
+          setValue={setValue}
+        />
+      )
+      await userEvent.click(screen.getAllByRole('checkbox')[0])
+      expect(setValue).toHaveBeenCalledWith(['blue', 'red'])
+    })
+
+    it('falls back to a text note when no option survives normalization', () => {
+      render(
+        <ChoicePickerRenderer
+          {...base}
+          rest={{ options: [{ label: 'A' }, { label: 'B' }] }}
+          label="Color"
+          value={[]}
+          setValue={() => undefined}
+        />
+      )
+      expect(screen.queryAllByRole('radio')).toHaveLength(0)
+      expect(screen.getByTestId('a2ui-fallback')).toBeInTheDocument()
+    })
+  })
+
+  describe('selection caps', () => {
+    it('renders radios (single selection) when the variant is omitted', async () => {
+      const setValue = vi.fn()
+      render(
+        <ChoicePickerRenderer
+          {...base}
+          rest={{ options }}
+          label="Color"
+          value={[]}
+          setValue={setValue}
+        />
+      )
+      expect(screen.queryAllByRole('checkbox')).toHaveLength(0)
+      const radios = screen.getAllByRole('radio')
+      expect(radios).toHaveLength(2)
+      await userEvent.click(radios[1])
+      expect(setValue).toHaveBeenCalledWith(['blue'])
+    })
+
+    it('keeps at most one option checked when the agent pre-selects several', () => {
+      render(
+        <ChoicePickerRenderer
+          {...base}
+          rest={{ variant: 'mutuallyExclusive', options }}
+          label="Color"
+          value={['red', 'blue']}
+          setValue={() => undefined}
+        />
+      )
+      const radios = screen.getAllByRole('radio') as HTMLInputElement[]
+      // Only the first selected value survives the cap; the browser must not be
+      // left to arbitrate between two radios both told they are checked.
+      expect(radios.filter((radio) => radio.checked)).toHaveLength(1)
+      expect(radios[0]).toBeChecked()
+      expect(radios[1]).not.toBeChecked()
+    })
+  })
+})
+
+describe('SliderRenderer', () => {
+  it('renders label, bound value and the native range input', () => {
+    render(
+      <SliderRenderer
+        {...base}
+        rest={{ min: 0, max: 10 }}
+        label="Rating"
+        value={7}
+        setValue={() => undefined}
+      />
+    )
+    expect(screen.getByText('Rating')).toBeInTheDocument()
+    const slider = screen.getByRole('slider')
+    expect(slider).toHaveValue('7')
+    expect(slider).toHaveAttribute('min', '0')
+    expect(slider).toHaveAttribute('max', '10')
+  })
+
+  it('propagates changes as numbers through setValue', () => {
+    const setValue = vi.fn()
+    render(
+      <SliderRenderer {...base} rest={{ min: 0, max: 10 }} label="Rating" value={1} setValue={setValue} />
+    )
+    const slider = screen.getByRole('slider')
+    // range inputs do not support userEvent.type; drive the change event directly
+    fireEvent.change(slider, { target: { value: '5' } })
+    expect(setValue).toHaveBeenCalledWith(5)
+  })
+
+  it('writes the displayed default into the data model when the value is unset', () => {
+    const setValue = vi.fn()
+    render(
+      <SliderRenderer {...base} rest={{ min: 2, max: 10 }} label="Rating" setValue={setValue} />
+    )
+    expect(screen.getByRole('slider')).toHaveValue('2')
+    expect(setValue).toHaveBeenCalledWith(2)
+  })
+
+  it('does not overwrite a value already present in the data model', () => {
+    const setValue = vi.fn()
+    render(
+      <SliderRenderer {...base} rest={{ min: 2, max: 10 }} label="Rating" value={6} setValue={setValue} />
+    )
+    expect(setValue).not.toHaveBeenCalled()
+  })
+})
+
+describe('DateTimeInputRenderer', () => {
+  it('renders a date field when the agent sets neither enableDate nor enableTime', () => {
+    render(<DateTimeInputRenderer {...base} label="When" value="" setValue={() => undefined} />)
+    expect(screen.getByText('When')).toBeInTheDocument()
+    expect(screen.getByRole('textbox')).toBeInTheDocument()
+  })
+
+  it('renders a native time field for a time-only input', () => {
+    const { container } = render(
+      <DateTimeInputRenderer
+        {...base}
+        rest={{ enableTime: true }}
+        label="At"
+        value="14:30"
+        setValue={() => undefined}
+      />
+    )
+    expect(container.querySelector('input[type="time"]')).not.toBeNull()
+  })
+})
