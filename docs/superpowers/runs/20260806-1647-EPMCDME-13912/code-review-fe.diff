+
+/**
+ * Declarative registry binding the 18 A2UI Basic Catalog components to the
+ * existing design-system controls (inputs/buttons/date picker) and to
+ * Tailwind/DS primitives for media and layout. The renderer's bundled demo
+ * implementations are intentionally not used.
+ */
+
+// --------------------------------------------------------------------------
+// Text
+// --------------------------------------------------------------------------
+
+const TEXT_VARIANT_STYLES: Record<
+  string,
+  { Tag: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'p' | 'span'; className: string }
+> = {
+  h1: { Tag: 'h1', className: 'text-2xl font-semibold text-text-primary' },
+  h2: { Tag: 'h2', className: 'text-xl font-semibold text-text-primary' },
+  h3: { Tag: 'h3', className: 'text-lg font-semibold text-text-primary' },
+  h4: { Tag: 'h4', className: 'text-base font-semibold text-text-primary' },
+  h5: { Tag: 'h5', className: 'text-sm font-semibold text-text-primary' },
+  caption: { Tag: 'span', className: 'text-xs text-text-tertiary' },
+  body: { Tag: 'p', className: 'text-sm text-text-primary' },
+}
+
+export const TextRenderer: React.FC<A2uiRenderProps> = ({ props }) => {
+  const variant = typeof props.variant === 'string' ? props.variant : 'body'
+  const { Tag, className } = TEXT_VARIANT_STYLES[variant] ?? TEXT_VARIANT_STYLES.body
+  return <Tag className={className}>{props.text == null ? '' : String(props.text)}</Tag>
+}
+
+// --------------------------------------------------------------------------
+// Media: Image / Icon / Video / AudioPlayer
+// --------------------------------------------------------------------------
+
+const IMAGE_VARIANT_STYLES: Record<string, string> = {
+  icon: 'w-5 h-5',
+  avatar: 'w-10 h-10 rounded-full object-cover',
+  smallFeature: 'max-w-40',
+  mediumFeature: 'max-w-80',
+  largeFeature: 'max-w-[480px]',
+  header: 'w-full max-h-64',
+}
+
+const IMAGE_FIT_STYLES: Record<string, string> = {
+  contain: 'object-contain',
+  cover: 'object-cover',
+  fill: 'object-fill',
+  none: 'object-none',
+  scaleDown: 'object-scale-down',
+}
+
+/**
+ * Privacy attributes shared by every agent-authored media element.
+ *
+ * `referrerPolicy` keeps the conversation/assistant identifiers that live in the
+ * chat URL out of the request. Credentials are not additionally suppressed with
+ * `crossOrigin`: it would force a CORS-mode fetch and break every host that does
+ * not send `Access-Control-Allow-Origin`, while cross-site cookies on subresource
+ * requests are already withheld by the SameSite default.
+ */
+const MEDIA_PRIVACY_PROPS = {
+  referrerPolicy: 'no-referrer',
+} as const
+
+export const ImageRenderer: React.FC<MediaRenderProps> = ({ url, rest }) => (
+  <img
+    src={url}
+    alt={typeof rest.description === 'string' ? rest.description : ''}
+    loading="lazy"
+    {...MEDIA_PRIVACY_PROPS}
+    className={cn(
