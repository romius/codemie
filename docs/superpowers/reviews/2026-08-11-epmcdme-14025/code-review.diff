-"""Custom LiteLLM proxy callback: fix streaming cost model name.
-
-The proxy's SSE streaming cost injection computes cost from the client-facing alias
-(``request_data["model"]``, e.g. ``claude-sonnet-5``) instead of the router-resolved
-deployment (e.g. ``bedrock/us.anthropic.claude-sonnet-5``). For Bedrock models this hits the
-Anthropic-direct price table and diverges from the dashboard cost (which is computed from the
-resolved model via ``logging_obj``).
-
-This callback runs ``async_post_call_streaming_iterator_hook`` *before* the proxy's cost
-injection and rewrites ``request_data["model"]`` to the resolved deployment so both paths use
-the same (correct) pricing. Spend/dashboard logging keys off ``logging_obj``, not
-``request_data["model"]``, so the change is scoped to the streaming cost calculation.
+"""Custom LiteLLM proxy callbacks.
+
+Fixes bundled here:
+
+1. **Bedrock streaming cost model fix** — ``async_post_call_streaming_iterator_hook``
+   The proxy's SSE streaming cost injection computes cost from the client-facing alias
+   (``request_data["model"]``, e.g. ``claude-sonnet-5``) instead of the router-resolved
+   deployment (e.g. ``bedrock/us.anthropic.claude-sonnet-5``). For Bedrock models this hits the
+   Anthropic-direct price table and diverges from the dashboard cost (which is computed from the
+   resolved model via ``logging_obj``).
+   Rewrites ``request_data["model"]`` to the resolved deployment so both paths use the same
+   (correct) pricing.
+
+2. **Responses API store=False reasoning-item strip** — ``async_pre_call_hook``
+   When a model entry has ``litellm_params.store: false``, LiteLLM injects ``store=False``
+   into every outgoing request.  On turn 2+ the Codex CLI includes reasoning items
+   (``type=reasoning``, ``encrypted_content``) that reference server-side state from turn 1.
+   Azure rejects these with 400 because the items were never persisted (``store=False`` on
+   turn 1 prevented storage).  This hook strips such reasoning items from the input before
+   the request reaches Azure, making the turn stateless and consistent with the
+   ``store=False`` semantics.
 """
 
 from typing import Any, AsyncGenerator, Optional
@@ -33,7 +42,38 @@ from litellm.proxy._types import UserAPIKeyAuth
 
 
 class BedrockCostModelFixLogger(CustomLogger):
-    """Point streaming cost injection at the router-resolved deployment model."""
+    """Proxy callback: Bedrock cost fix + Responses API store=False guard."""
+
+    # ------------------------------------------------------------------ #
+    # pre-call: strip reasoning items when store=False                    #
+    # ------------------------------------------------------------------ #
+
+    async def async_pre_call_hook(
+        self,
+        user_api_key_dict: UserAPIKeyAuth,
+        cache: Any,
+        data: dict,
+        call_type: str,
+    ) -> dict:
+        if data.get("store") is False:
+            input_items = data.get("input")
+            if isinstance(input_items, list):
+                filtered = [
+                    item
+                    for item in input_items
+                    if not (
+                        isinstance(item, dict)
+                        and item.get("type") == "reasoning"
+                        and item.get("encrypted_content")
+                    )
+                ]
+                if len(filtered) < len(input_items):
+                    data["input"] = filtered
+        return data
+
+    # ------------------------------------------------------------------ #
+    # post-call streaming: fix Bedrock cost model name                    #
+    # ------------------------------------------------------------------ #
 
     @staticmethod
     def _resolved_deployment(request_data: dict) -> Optional[str]:
