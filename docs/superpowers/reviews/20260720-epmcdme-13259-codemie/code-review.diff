+        history_index=0,
+        time_elapsed=1.0,
+        input_tokens=1,
+        output_tokens=1,
+        file_names=[],
+        money_spent=0.0,
+    )
+    assert user_message.interactive_response is None
+    assert assistant_message.interactive_request is None
