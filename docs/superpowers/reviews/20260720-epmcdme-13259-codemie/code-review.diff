+    {"kind": "story-ac", "item": "Text-only chat not regressed", "status": "pass", "notes": "all wire fields Optional/None; tool appended only when enabled; ChatPrompt untouched"},
+    {"kind": "spec", "item": "Optional wire fields on stream/request/history models", "status": "pass", "notes": "round-trip tests in TestWireFields"},
+    {"kind": "spec", "item": "request_user_input tool: dynamic schema, return_direct, registered only when enabled", "status": "pass", "notes": "tests cover emission, disabled rejection, no-op branches"},
+    {"kind": "spec", "item": "InteractiveFeaturesConfig JSONB column + migration + AssistantRequest field", "status": "pass", "notes": "hedging_config precedent; migration i1n2t3e4r5a6 revises head p1q2r3s4t5u6, linear chain"},
