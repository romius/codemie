+    {"kind": "spec", "item": "Deployment gate features:interactiveElements (+ Helm note)", "status": "partial", "notes": "flag added, FE-gated; no server enforcement and no Helm ConfigMap note (CR-004)"},
+    {"kind": "spec", "item": "Protocol module path src/codemie/chains/interactive.py", "status": "partial", "notes": "implemented at src/codemie/core/interactive.py to avoid a circular import; location-only deviation, reconcile via mode: sync"},
+    {"kind": "spec", "item": "Compact chip rendering for structured user response", "status": "pass", "notes": "ChatUserMessage chip; ChatUserMessageChip.test.tsx"},
+    {"kind": "spec", "item": "Commit titles EPMCDME-13259: Description", "status": "pass", "notes": "all 12 feature commits conform"},
+    {"kind": "spec", "item": "No Jira/EPAM refs or unrelated changes in committed files", "status": "pass", "notes": "product source clean; the .env leak was removed from branch history during review"},
