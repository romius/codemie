+def _run_configure(*, request_policy, assistant_policy):
+    agent_kwargs = {}
+    assistant = MagicMock()
+    assistant.tool_permissions = ToolPermissionsConfig(tool_call_policy=assistant_policy)
+    request = MagicMock()
+    request.tool_call_policy = request_policy
