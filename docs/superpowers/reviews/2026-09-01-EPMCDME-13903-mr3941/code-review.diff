+        tool_permissions=enforcement,
+    ):
+        result = svc.get_effective_permissions(
+            _assistant(ToolCallPolicy.AUTO_APPROVE),
+            tool_call_policy_override=ToolCallPolicy.AUTO_APPROVE,
